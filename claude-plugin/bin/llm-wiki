def today_date() -> dt.date:
    """Return today's date, with an env override for deterministic fixtures."""
    override = os.environ.get("LLM_WIKI_TODAY")
    if override:
        try:
            return dt.date.fromisoformat(override[:10])
        except ValueError:
            raise SystemExit(f"invalid LLM_WIKI_TODAY date: {override!r}")
    return dt.date.today()


@dataclass
class Issue:
    severity: str
    message: str
    path: Path | None = None
    fixable: bool = False
    fixed: bool = False

    def sort_key(self) -> tuple[int, str, str]:
        order = {"critical": 0, "warning": 1, "suggestion": 2, "info": 3}
        return (order.get(self.severity, 9), self.rel, self.message)

    @property
    def rel(self) -> str:
        return str(self.path) if self.path else ""


@dataclass
class Document:
    path: Path
    frontmatter: dict[str, Any]
    body: str


@dataclass(frozen=True)
class CheckpointFinding:
    finding_id: str
    category: str
    severity: str
    path: str
    line: int
    message: str


class LintContext:
    def __init__(self, root: Path, fix: bool = False) -> None:
        self.root = root.resolve()
        self.fix = fix
        self.issues: list[Issue] = []
        self.fixes: list[str] = []
        self.documents: dict[Path, Document] = {}
        self.referenced_raw: set[Path] = set()

    def rel(self, path: Path | None) -> str:
        if path is None:
            return ""
        try:
            return path.resolve().relative_to(self.root).as_posix()
        except ValueError:
            return str(path)

    def issue(
        self,
        severity: str,
        message: str,
        path: Path | None = None,
        fixable: bool = False,
        fixed: bool = False,
    ) -> None:
        self.issues.append(Issue(severity, message, path, fixable, fixed))

    def fixed(self, message: str) -> None:
        self.fixes.append(message)

    def active_issues(self) -> list[Issue]:
        return [issue for issue in self.issues if not issue.fixed]

    def counts(self) -> dict[str, int]:
        counts = {"critical": 0, "warning": 0, "suggestion": 0, "info": 0}
        for issue in self.active_issues():
            counts[issue.severity] = counts.get(issue.severity, 0) + 1
        return counts


def parse_scalar(value: str) -> Any:
    value = value.strip()
    if value == "":
        return ""
    if value in {"null", "Null", "NULL", "~"}:
        return None
    if value in {"true", "True", "TRUE"}:
        return True
    if value in {"false", "False", "FALSE"}:
        return False
    if value.startswith("[") and value.endswith("]"):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [parse_scalar(part.strip()) for part in split_inline_list(inner)]
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    return value


def split_inline_list(value: str) -> list[str]:
    parts: list[str] = []
    current: list[str] = []
    quote: str | None = None
    for char in value:
        if char in {"'", '"'}:
            if quote is None:
                quote = char
            elif quote == char:
                quote = None
            current.append(char)
        elif char == "," and quote is None:
            parts.append("".join(current).strip())
            current = []
        else:
            current.append(char)
    parts.append("".join(current).strip())
    return parts


def parse_frontmatter_block(text: str) -> dict[str, Any]:
    data: dict[str, Any] = {}
    current_key: str | None = None
    for raw_line in text.splitlines():
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        if raw_line.startswith("  - ") and current_key:
            current_value = data.setdefault(current_key, [])
            if not isinstance(current_value, list):
                current_value = []
                data[current_key] = current_value
            current_value.append(parse_scalar(raw_line[4:]))
            continue
        if raw_line.startswith(" ") or ":" not in raw_line:
            continue
        key, value = raw_line.split(":", 1)
        key = key.strip()
        if not key:
            continue
        current_key = key
        value = value.strip()
        if value == "":
            data[key] = []
        else:
            data[key] = parse_scalar(value)
    return data


def split_markdown_frontmatter(text: str) -> tuple[str, str] | None:
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end == -1:
        return None
    return text[4:end], text[end + 4 :]


def frontmatter_field_value(frontmatter: str, field: str) -> str | None:
    match = re.search(rf"(?m)^{re.escape(field)}\s*:\s*(.*)$", frontmatter)
    if not match:
        return None
    value = match.group(1).strip()
    return value if value else None


def frontmatter_has_value(frontmatter: str, field: str) -> bool:
    value = frontmatter_field_value(frontmatter, field)
    if value not in {None, "", "[]"}:
        return True
    return bool(
        re.search(
            rf"(?ms)^{re.escape(field)}\s*:\s*\n(?:  - .+\n?)+",
            frontmatter,
        )
    )


def yaml_quote(value: str) -> str:
    value = re.sub(r"\s+", " ", value).strip()
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def insert_frontmatter_after_title(frontmatter: str, lines: list[str]) -> str:
    parts = frontmatter.splitlines()
    insert_at = 1 if parts else 0
    for index, line in enumerate(parts):
        if line.startswith("title:"):
            insert_at = index + 1
            break
    return "\n".join(parts[:insert_at] + lines + parts[insert_at:])


def append_frontmatter_lines(frontmatter: str, lines: list[str]) -> str:
    return frontmatter.rstrip() + "\n" + "\n".join(lines)


def set_frontmatter_list(frontmatter: str, field: str, values: list[str]) -> str:
    lines = frontmatter.splitlines()
    output: list[str] = []
    index = 0
    replaced = False
    while index < len(lines):
        line = lines[index]
        if re.match(rf"^{re.escape(field)}\s*:", line):
            output.append(f"{field}:")
            output.extend(f"  - {value}" for value in values)
            index += 1
            while index < len(lines) and lines[index].startswith("  - "):
                index += 1
            replaced = True
            continue
        output.append(line)
        index += 1
    if not replaced:
        output.append(f"{field}:")
        output.extend(f"  - {value}" for value in values)
    return "\n".join(output)


def first_body_summary(body: str) -> str:
    summary_match = re.search(r"(?m)^\*\*Summary\*\*:\s*(.+)$", body)
    if summary_match:
        return clean_summary(summary_match.group(1))

    paragraphs: list[str] = []
    current: list[str] = []
    in_code = False
    for raw_line in body.splitlines():
        line = raw_line.strip()
        if line.startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            continue
        if not line:
            if current:
                paragraphs.append(" ".join(current))
                current = []
            continue
        if (
            line.startswith("#")
            or line.startswith("|")
            or line.startswith("- ")
            or re.match(r"^\d+\.\s", line)
            or line == "---"
        ):
            if current:
                paragraphs.append(" ".join(current))
                current = []
            continue
        current.append(line)
    if current:
        paragraphs.append(" ".join(current))

    for paragraph in paragraphs:
        cleaned = clean_summary(paragraph)
        if len(cleaned) >= 40:
            return cleaned
    return "Compiled wiki article."


def clean_summary(value: str) -> str:
    value = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", value)
    value = re.sub(r"\[\[[^|\]]+\|([^\]]+)\]\]", r"\1", value)
    value = re.sub(r"\[\[([^\]]+)\]\]", r"\1", value)
    value = re.sub(r"[*_`]", "", value)
    value = re.sub(r"\s+", " ", value).strip()
    return value[:260].rstrip()


def write_markdown_frontmatter(path: Path, frontmatter: str, body: str) -> None:
    path.write_text("---\n" + frontmatter.rstrip() + "\n---" + body, encoding="utf-8")


def is_permission_denied(exc: BaseException) -> bool:
    return isinstance(exc, PermissionError) or getattr(exc, "errno", None) in PERMISSION_DENIED_ERRNOS


def permission_denied_message(path: Path | None, operation: str, exc: BaseException) -> str:
    target = str(path or getattr(exc, "filename", None) or "wiki path")
    return (
        f"permission denied while trying to {operation}: {target}\n"
        f"{type(exc).__name__}: {exc}\n\n"
        "The path exists, but this process cannot read or list its contents. "
        "On macOS this usually means the app launching Codex/the terminal lacks "
        "Full Disk Access or iCloud Drive access. Grant access to the exact launcher, "
        "restart Codex, and try again. The configured hub_path is probably correct; "
        "do not switch to a ~/wiki fallback or machine-local resolved_path for this error."
    )


def read_document(ctx: LintContext, path: Path) -> Document | None:
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        ctx.issue("critical", "Markdown file is not valid UTF-8.", path)
        return None
    except OSError as exc:
        if is_permission_denied(exc):
            ctx.issue("critical", permission_denied_message(path, "read file", exc), path)
            return None
        ctx.issue("critical", f"Could not read file: {exc}", path)
        return None

    if not text.startswith("---\n"):
        ctx.issue("critical", "Markdown file is missing YAML frontmatter.", path)
        return None
    end = text.find("\n---", 4)
    if end == -1:
        ctx.issue("critical", "Markdown file has unterminated YAML frontmatter.", path)
        return None
    frontmatter_text = text[4:end]
    body = text[end + 4 :]
    return Document(path=path, frontmatter=parse_frontmatter_block(frontmatter_text), body=body)


def markdown_files(root: Path) -> list[Path]:
    try:
        if not root.exists():
            return []
        return sorted(path for path in root.rglob("*.md") if path.is_file())
    except OSError as exc:
        if is_permission_denied(exc):
            raise SystemExit(permission_denied_message(root, "list markdown files under", exc)) from exc
        raise


def content_markdown_files(root: Path) -> list[Path]:
    return [
        path
        for path in markdown_files(root)
        if path.name != "_index.md" and path.name != "config.md"
    ]


def load_documents(ctx: LintContext) -> None:
    ctx.documents = {}
    for path in content_markdown_files(ctx.root):
        if not is_schema_checked_path(ctx.root, path):
            continue
        doc = read_document(ctx, path)
        if doc is not None:
            ctx.documents[path.resolve()] = doc


def is_schema_checked_path(root: Path, path: Path) -> bool:
    try:
        rel = path.resolve().relative_to(root)
    except ValueError:
        return False
    parts = rel.parts
    if not parts:
        return False
    return parts[0] in {"raw", "wiki", "inventory", "datasets"}


def require_fields(ctx: LintContext, doc: Document, fields: list[str]) -> None:
    for field in fields:
        value = doc.frontmatter.get(field)
        if value in (None, "", []):
            ctx.issue("critical", f"Required frontmatter field is missing or empty: {field}.", doc.path)


def check_enum(
    ctx: LintContext,
    doc: Document,
    field: str,
    allowed: set[str],
    severity: str = "critical",
) -> None:
    value = doc.frontmatter.get(field)
    if value in (None, ""):
        return
    if str(value) not in allowed:
        expected = ", ".join(sorted(allowed))
        ctx.issue(severity, f"Invalid {field}: {value!r}; expected one of {expected}.", doc.path)


def ensure_dir_index(ctx: LintContext, directory: Path) -> None:
    if not directory.exists():
        if ctx.fix:
            directory.mkdir(parents=True, exist_ok=True)
            ctx.fixed(f"Created directory {ctx.rel(directory)}.")
        else:
            ctx.issue("critical", "Required directory is missing.", directory, fixable=True)
            return
    index = directory / "_index.md"
    if not index.exists():
        if ctx.fix:
            regenerate_directory_index(ctx, directory)
        else:
            ctx.issue("critical", "Required _index.md is missing.", index, fixable=True)


def check_structure(ctx: LintContext) -> None:
    if not ctx.root.exists():
        ctx.issue("critical", "Wiki root does not exist.", ctx.root)
        return
    if is_hub(ctx.root):
        for name in ["wikis.json", "_index.md", "log.md", "topics"]:
            path = ctx.root / name
            if not path.exists():
                ctx.issue("critical", "Required hub path is missing.", path)
        return
    if not (ctx.root / "_index.md").exists():
        ctx.issue("critical", "Master _index.md is missing.", ctx.root / "_index.md", fixable=True)
    if not (ctx.root / "config.md").exists():
        ctx.issue("critical", "config.md is missing.", ctx.root / "config.md")
    ensure_topic_schema(ctx)

    required = [
        "raw",
        "raw/articles",
        "raw/papers",
        "raw/repos",
        "raw/notes",
        "raw/data",
        "wiki",
        "wiki/concepts",
        "wiki/topics",
        "wiki/references",
        "wiki/theses",
        "output",
    ]
    for rel in required:
        ensure_dir_index(ctx, ctx.root / rel)

    if (ctx.root / "inventory").exists():
        ensure_dir_index(ctx, ctx.root / "inventory")
        for rel in [
            "inventory/items",
            "inventory/ideas",
            "inventory/candidates",
            "inventory/entities",
            "inventory/corpora",
            "inventory/views",
        ]:
            path = ctx.root / rel
            if path.exists():
                ensure_dir_index(ctx, path)

    if (ctx.root / "datasets").exists():
        ensure_dir_index(ctx, ctx.root / "datasets")

        for manifest in sorted((ctx.root / "datasets").glob("*/MANIFEST.md")):
            dataset_dir = manifest.parent
            ensure_dir_index(ctx, dataset_dir)
            for rel in ["samples", "profiles", "queries"]:
                path = dataset_dir / rel
                if path.exists():
                    ensure_dir_index(ctx, path)

    inbox = ctx.root / "inbox"
    if not inbox.exists():
        if ctx.fix:
            inbox.mkdir(parents=True, exist_ok=True)
            (inbox / ".processed").mkdir(exist_ok=True)
            ctx.fixed("Created inbox/ and inbox/.processed/.")
        else:
            ctx.issue("warning", "inbox/ is missing.", inbox, fixable=True)


def ensure_topic_schema(ctx: LintContext) -> None:
    """Nudge or create the default topic guide.

    Topic guides are default from v0.15 onward, but existing wikis should not
    become structurally broken merely because they have not adopted one yet.
    Missing schema.md is therefore an info-level adoption prompt during
    read-only lint and an additive file creation during lint --fix.
    """
    schema = ctx.root / "schema.md"
    if schema.exists():
        return
    if ctx.fix:
        schema.write_text(default_schema_text(ctx.root), encoding="utf-8")
        ctx.fixed(f"Created starter topic guide at {ctx.rel(schema)}.")
    else:
        ctx.issue(
            "info",
            "Optional topic guide missing. Existing wiki is valid. Run `llm-wiki schema adopt` or `llm-wiki lint --fix` to add a starter `schema.md`.",
            schema,
            fixable=True,
        )


def default_schema_text(root: Path, state: str = "advisory") -> str:
    today = today_date().isoformat()
    title = topic_title(root, root.name)
    return "\n".join(
        [
            "---",
            f"title: {yaml_quote(title + ' Topic Guide')}",
            f"schema_state: {state}",
            f"created: {today}",
            f"updated: {today}",
            'summary: "Human-owned topic guide for local vocabulary, relationships, source boundaries, and conventions."',
            "---",
            "",
            f"# {title} Topic Guide",
            "",
            "> This is not a database schema and it does not make existing wiki content invalid.",
            "> It is a human-owned guide for local vocabulary, relationships, source boundaries, and conventions.",
            "> The librarian may propose improvements, but agents should not rewrite this file without explicit approval.",
            "",
            "## State",
            "",
            f"- `schema_state`: `{state}`",
            "- `advisory` means suggestions only.",
            "- Keep this advisory until the librarian's topic-guide suggestions are consistently low-noise.",
            "- `strict` is an advanced, explicit opt-in; it still never permits automatic content rewrites.",
            "",
            "## Entity Types",
            "",
            "| Type | Meaning |",
            "|------|---------|",
            "| `concept` | Bounded idea or mechanism compiled under `wiki/concepts/`. |",
            "| `topic` | Broad theme or playbook compiled under `wiki/topics/`. |",
            "| `reference` | Curated list, map, standard, or lookup page under `wiki/references/`. |",
            "| `source` | Raw evidence under `raw/`; factual claims should trace back here. |",
            "| `artifact` | Generated output, project file, inventory record, or dataset manifest. |",
            "",
            "## Relationship Verbs",
            "",
            "- `cites`: article or output cites a raw source.",
            "- `supports`: source or article supports a claim, plan, or decision.",
            "- `contradicts`: source or article conflicts with another claim.",
            "- `supersedes`: newer article/output replaces an older one.",
            "- `depends-on`: artifact or workflow relies on another artifact.",
            "- `implements`: code, output, or project implements a plan.",
            "- `relates-to`: weak relationship used when a stronger verb is not yet justified.",
            "",
            "## Source Conventions",
            "",
            "- Keep raw sources immutable under `raw/`.",
            "- Compile durable synthesis under `wiki/` with explicit `sources:` frontmatter.",
            "- Keep generated deliverables under `output/`.",
            "- Use inventory for durable tracking state, not factual evidence.",
            "- Use dataset manifests for large, mutable, binary, remote, or query-oriented data.",
            "",
            "## Compile Guidance",
            "",
            "<!-- Record only topic-specific rules that improve article planning. -->",
            "<!-- Examples: one article per mechanism; keep X separate from Y; refer Z claims to another topic. -->",
            "- Shape article cardinality, boundaries, and scope here when this topic needs rules beyond the global defaults.",
            "- This guidance does not redefine global categories or frontmatter and does not exempt raw sources from C6 coverage.",
            "- In advisory mode, compilation explains deliberate deviations; in strict mode, it requests confirmation before writing them.",
            "",
            "## Adoption Notes",
            "",
            "- Existing articles do not need immediate rewrites to adopt this guide.",
            "- Librarian topic-guide scans should propose changes in `output/schema-proposal-*.md`.",
            "- Promote only the small conventions that fit this topic; delete unused starter rows.",
            "- Prefer staying advisory unless the human explicitly wants stricter convention warnings.",
            "",
        ]
    )


def is_hub(path: Path) -> bool:
    return (path / "wikis.json").exists() and (path / "topics").exists()


def check_frontmatter_schema(ctx: LintContext) -> None:
    for doc in sorted(ctx.documents.values(), key=lambda item: str(item.path)):
        rel = doc.path.resolve().relative_to(ctx.root)
        parts = rel.parts
        if not parts:
            continue
        if parts[0] == "raw":
            require_fields(ctx, doc, ["title", "source", "type", "ingested", "tags", "summary"])
            check_enum(ctx, doc, "type", RAW_TYPES)
        elif parts[0] == "wiki":
            if doc.frontmatter.get("type") == "thesis":
                require_fields(ctx, doc, ["title", "created", "updated", "tags", "summary"])
            else:
                require_fields(ctx, doc, ["title", "category", "created", "updated", "tags", "summary"])
                check_enum(ctx, doc, "category", ARTICLE_CATEGORIES)
            if "confidence" in doc.frontmatter:
                check_enum(ctx, doc, "confidence", CONFIDENCE_VALUES, severity="warning")
            if "volatility" in doc.frontmatter:
                check_enum(ctx, doc, "volatility", VOLATILITY_VALUES, severity="warning")
        elif parts[0] == "inventory":
            if len(parts) >= 2 and parts[1] == "views":
                require_fields(ctx, doc, ["title", "view", "updated", "summary"])
            else:
                require_fields(
                    ctx,
                    doc,
                    ["title", "kind", "status", "priority", "created", "updated", "tags", "summary"],
                )
                check_enum(ctx, doc, "kind", INVENTORY_KINDS)
                check_enum(ctx, doc, "status", INVENTORY_STATUSES)
                check_enum(ctx, doc, "priority", INVENTORY_PRIORITIES)
        elif parts[0] == "datasets" and doc.path.name == "MANIFEST.md":
            require_fields(
                ctx,
                doc,
                [
                    "title",
                    "dataset_id",
                    "status",
                    "storage",
                    "locations",
                    "formats",
                    "schema_status",
                    "created",
                    "updated",
                    "tags",
                    "summary",
                ],
            )
            check_enum(ctx, doc, "status", DATASET_STATUSES)
            check_enum(ctx, doc, "storage", DATASET_STORAGE)
            check_enum(ctx, doc, "schema_status", SCHEMA_STATUSES)

        tags = doc.frontmatter.get("tags")
        if "tags" in doc.frontmatter and (not isinstance(tags, list) or not tags):
            ctx.issue("warning", "tags must be a non-empty list.", doc.path)


def fix_legacy_wiki_frontmatter(ctx: LintContext) -> None:
    if not ctx.fix:
        return
    changed = False
    today = today_date().isoformat()
    for doc in sorted(ctx.documents.values(), key=lambda item: str(item.path)):
        try:
            rel = doc.path.resolve().relative_to(ctx.root)
        except ValueError:
            continue
        if len(rel.parts) < 3 or rel.parts[0] != "wiki":
            continue
        text = doc.path.read_text(encoding="utf-8")
        parts = split_markdown_frontmatter(text)
        if parts is None:
            continue
        frontmatter, body = parts
        original = frontmatter
        bucket = rel.parts[1]
        is_thesis = doc.frontmatter.get("type") == "thesis" or bucket == "theses"

        if not is_thesis and bucket in {"concepts", "topics", "references"} and not frontmatter_has_value(
            frontmatter, "category"
        ):
            frontmatter = insert_frontmatter_after_title(
                frontmatter,
                [f"category: {bucket[:-1] if bucket.endswith('s') else bucket}"],
            )

        if not frontmatter_has_value(frontmatter, "summary"):
            frontmatter = insert_frontmatter_after_title(
                frontmatter,
                [f"summary: {yaml_quote(first_body_summary(body))}"],
            )

        if not frontmatter_has_value(frontmatter, "tags"):
            tag = "thesis" if is_thesis else bucket[:-1] if bucket.endswith("s") else "wiki"
            frontmatter = append_frontmatter_lines(frontmatter, [f"tags: [{tag}]"])

        if not frontmatter_has_value(frontmatter, "created"):
            created = (
                frontmatter_field_value(frontmatter, "updated")
                or frontmatter_field_value(frontmatter, "verified")
                or today
            )
            frontmatter = append_frontmatter_lines(frontmatter, [f"created: {created}"])

        if not frontmatter_has_value(frontmatter, "updated"):
            updated = (
                frontmatter_field_value(frontmatter, "created")
                or frontmatter_field_value(frontmatter, "verified")
                or today
            )
            frontmatter = append_frontmatter_lines(frontmatter, [f"updated: {updated}"])

        if not frontmatter_has_value(frontmatter, "volatility"):
            frontmatter = append_frontmatter_lines(frontmatter, ["volatility: warm"])

        if frontmatter != original:
            write_markdown_frontmatter(doc.path, frontmatter, body)
            ctx.fixed(f"Repaired frontmatter in {ctx.rel(doc.path)}.")
            changed = True

    if changed:
        load_documents(ctx)


def canonical_path_for(root: Path, doc: Document) -> Path | None:
    rel = doc.path.resolve().relative_to(root)
    parts = rel.parts
    if not parts:
        return None
    fm = doc.frontmatter
    if parts[0] == "raw":
        source_type = fm.get("type")
        if source_type in RAW_TYPES:
            return root / "raw" / str(source_type) / doc.path.name
    if parts[0] == "wiki":
        if fm.get("type") == "thesis":
            return root / "wiki" / "theses" / doc.path.name
        category = fm.get("category")
        if category in ARTICLE_DIRS:
            return root / "wiki" / ARTICLE_DIRS[str(category)] / doc.path.name
    if parts[0] == "inventory" and len(parts) >= 2 and parts[1] != "views":
        kind = fm.get("kind")
        if kind == "item":
            return root / "inventory" / "items" / doc.path.name
        if kind == "idea":
            return root / "inventory" / "ideas" / doc.path.name
        if kind == "entity":
            return root / "inventory" / "entities" / doc.path.name
        if kind == "corpus":
            return root / "inventory" / "corpora" / doc.path.name
        if kind in {"ingest-candidate", "question", "task", "artifact", "watch"}:
            return root / "inventory" / "candidates" / doc.path.name
    return None


def check_canonical_placement(ctx: LintContext) -> None:
    moved = False
    for doc in list(sorted(ctx.documents.values(), key=lambda item: str(item.path))):
        try:
            rel = doc.path.resolve().relative_to(ctx.root)
        except ValueError:
            continue
        if rel.parts[0] not in {"raw", "wiki", "inventory"}:
            continue
        expected = canonical_path_for(ctx.root, doc)
        if expected is None or expected.resolve() == doc.path.resolve():
            continue
        if ctx.fix:
            expected.parent.mkdir(parents=True, exist_ok=True)
            if expected.exists():
                ctx.issue(
                    "critical",
                    f"File belongs at {ctx.rel(expected)}, but destination already exists.",
                    doc.path,
                )
                continue
            shutil.move(str(doc.path), str(expected))
            ctx.issue(
                "critical",
                f"Moved misplaced file to {ctx.rel(expected)}.",
                doc.path,
                fixed=True,
            )
            ctx.fixed(f"Moved {ctx.rel(doc.path)} to {ctx.rel(expected)}.")
            moved = True
        else:
            ctx.issue(
                "critical",
                f"File is in the wrong directory; expected {ctx.rel(expected)}.",
                doc.path,
                fixable=True,
            )

    for manifest in sorted((ctx.root / "datasets").glob("*/MANIFEST.md")):
        doc = ctx.documents.get(manifest.resolve())
        if not doc:
            continue
        dataset_id = doc.frontmatter.get("dataset_id")
        if dataset_id and dataset_id != manifest.parent.name:
            ctx.issue(
                "warning",
                f"Dataset manifest directory does not match dataset_id {dataset_id!r}.",
                manifest,
            )

    if moved:
        load_documents(ctx)


def check_unknown_files(ctx: LintContext) -> None:
    if not ctx.root.exists():
        return
    root_allowed = HUB_ALLOWED if is_hub(ctx.root) else ROOT_ALLOWED
    if (ctx.root / ".git").exists():
        root_allowed = root_allowed | GIT_ROOT_META_ALLOWED
    for child in sorted(ctx.root.iterdir()):
        if child.name not in root_allowed:
            handle_unknown(ctx, child, "Unexpected file or directory at wiki root.")

    scan_fixed_allowed(ctx, ctx.root / "raw", RAW_ALLOWED, "raw/")
    scan_fixed_allowed(ctx, ctx.root / "wiki", WIKI_ALLOWED, "wiki/")
    scan_fixed_allowed(ctx, ctx.root / "inventory", INVENTORY_ALLOWED, "inventory/")

    datasets = ctx.root / "datasets"
    if datasets.exists():
        for child in sorted(datasets.iterdir()):
            if child.name == "_index.md":
                continue
            if child.is_dir():
                for dataset_child in sorted(child.iterdir()):
                    if dataset_child.name not in DATASET_CHILD_ALLOWED:
                        handle_unknown(
                            ctx,
                            dataset_child,
                            f"Unexpected file or directory in datasets/{child.name}/.",
                        )
                for subdir_name in ["samples", "profiles", "queries"]:
                    subdir = child / subdir_name
                    if subdir.exists():
                        for note in sorted(subdir.iterdir()):
                            if note.name == "_index.md":
                                continue
                            if not note.is_file() or note.suffix != ".md":
                                handle_unknown(
                                    ctx,
                                    note,
                                    f"Unexpected file in datasets/{child.name}/{subdir_name}/.",
                                )
            else:
                handle_unknown(ctx, child, "Unexpected file in datasets/.")

    for base, allowed_dirs in [
        (ctx.root / "raw", {"articles", "papers", "repos", "notes", "data"}),
        (ctx.root / "wiki", {"concepts", "topics", "references", "theses"}),
        (
            ctx.root / "inventory",
            {"items", "ideas", "candidates", "entities", "corpora", "views"},
        ),
    ]:
        if not base.exists():
            continue
        for subdir in allowed_dirs:
            path = base / subdir
            if not path.exists():
                continue
            for child in sorted(path.iterdir()):
                if child.name == "_index.md":
                    continue
                if not child.is_file() or child.suffix != ".md":
                    handle_unknown(ctx, child, f"Unexpected file in {ctx.rel(path)}/.")


def scan_fixed_allowed(ctx: LintContext, directory: Path, allowed: set[str], label: str) -> None:
    if not directory.exists():
        return
    for child in sorted(directory.iterdir()):
        if child.name not in allowed:
            handle_unknown(ctx, child, f"Unexpected file or directory in {label}.")


def handle_unknown(ctx: LintContext, path: Path, message: str) -> None:
    if path.is_dir():
        ctx.issue("warning", f"{message} Unknown directories are not auto-fixed.", path)
        return
    if ctx.fix:
        unknown = ctx.root / "inbox" / ".unknown"
        unknown.mkdir(parents=True, exist_ok=True)
        dest = unique_destination(unknown / path.name)
        shutil.move(str(path), str(dest))
        ctx.issue("warning", f"Moved unexpected file to {ctx.rel(dest)}.", path, fixed=True)
        ctx.fixed(f"Moved {ctx.rel(path)} to {ctx.rel(dest)}.")
    else:
        ctx.issue("warning", message, path, fixable=True)


def unique_destination(path: Path) -> Path:
    if not path.exists():
        return path
    stem = path.stem
    suffix = path.suffix
    for index in range(2, 1000):
        candidate = path.with_name(f"{stem}-{index}{suffix}")
        if not candidate.exists():
            return candidate
    raise RuntimeError(f"could not choose unique destination for {path}")


def check_index_consistency(ctx: LintContext) -> None:
    for directory in sorted(path for path in ctx.root.rglob("*") if path.is_dir()):
        if not is_index_checked_directory(ctx.root, directory):
            continue
        index = directory / "_index.md"
        if not index.exists():
            continue
        try:
            text = index.read_text(encoding="utf-8")
        except OSError as exc:
            ctx.issue("warning", f"Could not read index: {exc}", index)
            continue
        contract = index_contract(ctx.root, directory)
        missing_entries = [
            path for path in index_contract_entries(directory, contract)
            if not index_links_to(text, path.relative_to(directory).as_posix())
        ]
        dead_links: list[str] = []
        for link in extract_markdown_links(text):
            if not is_local_markdown_link(link):
                continue
            target = resolve_link_target(directory, link)
            if not target.exists():
                dead_links.append(link)
        if ctx.fix and (missing_entries or dead_links):
            regenerate_directory_index(ctx, directory, contract)
            continue
        for path in missing_entries:
            ctx.issue(
                "warning",
                f"Required {index_contract_label(contract)} entry is missing from directory index.",
                path,
            )
        for link in dead_links:
            ctx.issue("warning", f"Index links to missing file: {link}.", index)


def is_index_checked_directory(root: Path, directory: Path) -> bool:
    try:
        rel = directory.resolve().relative_to(root)
    except ValueError:
        return False
    if not rel.parts or any(part.startswith(".") for part in rel.parts):
        return False
    return rel.parts[0] in {"raw", "wiki", "inventory", "datasets", "output"}


def index_contract(root: Path, directory: Path) -> str:
    """Return the declared shape for an index, never infer it from its text."""
    rel = directory.resolve().relative_to(root).parts
    if rel == ("raw",):
        return "raw-root"
    if rel == ("wiki",):
        return "wiki-root"
    if rel == ("inventory",):
        return "inventory-root"
    if rel == ("datasets",):
        return "datasets-root"
    if rel == ("output",):
        return "output-root"
    if len(rel) == 2 and rel[0] == "datasets":
        return "dataset-root"
    return "direct-files"


def index_contract_label(contract: str) -> str:
    return {
        "raw-root": "raw category pointer",
        "wiki-root": "wiki category pointer",
        "inventory-root": "inventory navigation or record rollup",
        "datasets-root": "dataset manifest registry",
        "output-root": "output artifact or project entry",
        "dataset-root": "dataset manifest or navigation entry",
        "direct-files": "file",
    }[contract]


def index_contract_entries(directory: Path, contract: str) -> list[Path]:
    if contract == "raw-root":
        return existing_category_indexes(directory, RAW_INDEX_CATEGORIES)
    if contract == "wiki-root":
        return existing_category_indexes(directory, WIKI_INDEX_CATEGORIES)
    if contract == "inventory-root":
        navigation = existing_category_indexes(directory, INVENTORY_NAVIGATION_DIRS)
        return navigation + inventory_record_files(directory)
    if contract == "datasets-root":
        return sorted(directory.glob("*/MANIFEST.md"))
    if contract == "output-root":
        return output_loose_files(directory) + output_project_why_files(directory)
    if contract == "dataset-root":
        entries = sorted(path for path in directory.glob("*.md") if path.name != "_index.md")
        for name in ("samples", "profiles", "queries"):
            index = directory / name / "_index.md"
            if index.exists():
                entries.append(index)
        return entries
    return sorted(
        path for path in directory.glob("*.md") if path.name != "_index.md"
    )


def existing_category_indexes(directory: Path, names: list[str]) -> list[Path]:
    return [
        directory / name / "_index.md"
        for name in names
        if (directory / name).exists()
    ]


def inventory_record_files(directory: Path) -> list[Path]:
    records: list[Path] = []
    for name in INVENTORY_RECORD_DIRS:
        child = directory / name
        if child.exists():
            records.extend(path for path in child.glob("*.md") if path.name != "_index.md")
    return sorted(records, key=lambda path: path.relative_to(directory).as_posix())


def output_loose_files(directory: Path) -> list[Path]:
    return sorted(path for path in directory.glob("*.md") if path.name != "_index.md")


def output_project_why_files(directory: Path) -> list[Path]:
    projects = directory / "projects"
    if not projects.exists():
        return []
    return sorted(
        project / "WHY.md"
        for project in projects.iterdir()
        if project.is_dir() and not project.name.startswith(".") and (project / "WHY.md").exists()
    )


def index_links_to(text: str, expected: str) -> bool:
    return expected in {link.split("#", 1)[0].replace("\\", "/") for link in extract_markdown_links(text)}


def index_frontmatter(ctx: LintContext, path: Path) -> dict[str, Any]:
    doc = ctx.documents.get(path.resolve())
    if doc:
        return doc.frontmatter
    try:
        split = split_markdown_frontmatter(path.read_text(encoding="utf-8"))
    except OSError:
        return {}
    return parse_frontmatter_block(split[0]) if split else {}


def regenerate_directory_index(
    ctx: LintContext, directory: Path, contract: str | None = None
) -> None:
    contract = contract or index_contract(ctx.root, directory)
    renderers = {
        "raw-root": render_category_pointer_index,
        "wiki-root": render_category_pointer_index,
        "inventory-root": render_inventory_index,
        "datasets-root": render_dataset_registry_index,
        "output-root": render_output_index,
        "dataset-root": render_dataset_index,
        "direct-files": render_direct_file_index,
    }
    text = renderers[contract](ctx, directory, contract)
    index = directory / "_index.md"
    index.write_text(text, encoding="utf-8")
    ctx.fixed(f"Regenerated {index_contract_label(contract)} index {ctx.rel(index)}.")


def render_category_pointer_index(ctx: LintContext, directory: Path, contract: str) -> str:
    title = "Raw Sources Index" if contract == "raw-root" else "Wiki Articles"
    categories = RAW_INDEX_CATEGORIES if contract == "raw-root" else WIKI_INDEX_CATEGORIES
    lines = [f"# {title}", ""]
    for category in categories:
        index = directory / category / "_index.md"
        if not index.exists():
            continue
        lines.extend([
            f"## {category.title()}",
            f"See [{category}/_index.md]({category}/_index.md)",
            "",
        ])
    if contract == "raw-root":
        count = len([
            path for category in RAW_INDEX_CATEGORIES
            for path in (directory / category).glob("*.md")
            if path.name != "_index.md"
        ])
        lines.extend(["## Stats", f"- Total sources: {count}", f"- Last updated: {today_date().isoformat()}", ""])
    return "\n".join(lines)


def render_inventory_index(ctx: LintContext, directory: Path, contract: str) -> str:
    records = inventory_record_files(directory)
    counts = {
        name: len([path for path in records if path.parent.name == name])
        for name in INVENTORY_RECORD_DIRS
    }
    statuses = [str(index_frontmatter(ctx, path).get("status") or "") for path in records]
    lines = [
        "# Inventory Index",
        "",
        "> Durable tracking records for items, candidates, entities, corpora, and watch items.",
        "",
        f"Last updated: {today_date().isoformat()}",
        "",
        "## Statistics",
        "",
        f"- Total records: {len(records)}",
        f"- Items: {counts['items']}",
        f"- Ideas: {counts['ideas']}",
        f"- Candidates: {counts['candidates']}",
        f"- Entities: {counts['entities']}",
        f"- Corpora: {counts['corpora']}",
        f"- Active: {statuses.count('active')}",
        f"- Blocked: {statuses.count('blocked')}",
        "",
        "## Quick Navigation",
        "",
    ]
    for name in INVENTORY_NAVIGATION_DIRS:
        index = directory / name / "_index.md"
        if index.exists():
            lines.append(f"- [{name.title()}]({name}/_index.md)")
    lines.extend(["", "## Contents", "", "| File | Kind | Status | Priority | Next Action | Updated |", "|------|------|--------|----------|-------------|---------|"])
    for path in records:
        frontmatter = index_frontmatter(ctx, path)
        link = path.relative_to(directory).as_posix()
        lines.append(
            f"| [{table_cell(path.name)}]({markdown_link_destination(link)}) | "
            f"{table_cell(str(frontmatter.get('kind') or ''))} | "
            f"{table_cell(str(frontmatter.get('status') or ''))} | "
            f"{table_cell(str(frontmatter.get('priority') or ''))} | "
            f"{table_cell(str(frontmatter.get('next_action') or ''))} | "
            f"{table_cell(index_updated(frontmatter))} |"
        )
    return "\n".join(lines) + "\n"


def render_dataset_registry_index(ctx: LintContext, directory: Path, contract: str) -> str:
    manifests = sorted(directory.glob("*/MANIFEST.md"))
    statuses = [str(index_frontmatter(ctx, path).get("status") or "") for path in manifests]
    lines = [
        "# Dataset Registry Index",
        "",
        "> Dataset manifests for large or external data indexed by this wiki.",
        "",
        f"Last updated: {today_date().isoformat()}",
        "",
        "## Statistics",
        "",
        f"- Datasets: {len(manifests)}",
        f"- Active: {statuses.count('active')}",
        f"- External: {statuses.count('external')}",
        f"- Unavailable: {statuses.count('unavailable')}",
        "",
        "## Contents",
        "",
        "| Dataset | Status | Storage | Formats | Size | Records | Updated |",
        "|---------|--------|---------|---------|------|---------|---------|",
    ]
    for path in manifests:
        frontmatter = index_frontmatter(ctx, path)
        link = path.relative_to(directory).as_posix()
        formats = ", ".join(as_string_list(frontmatter.get("formats")))
        lines.append(
            f"| [{table_cell(str(frontmatter.get('title') or path.parent.name))}]({markdown_link_destination(link)}) | "
            f"{table_cell(str(frontmatter.get('status') or ''))} | "
            f"{table_cell(str(frontmatter.get('storage') or ''))} | {table_cell(formats)} | "
            f"{table_cell(str(frontmatter.get('size') or 'unknown'))} | "
            f"{table_cell(str(frontmatter.get('records') or 'unknown'))} | "
            f"{table_cell(index_updated(frontmatter))} |"
        )
    return "\n".join(lines) + "\n"


def render_output_index(ctx: LintContext, directory: Path, contract: str) -> str:
    lines = ["# Output Artifacts", "", "## Outputs", "", "| Output | Type | Date |", "|--------|------|------|"]
    for path in output_loose_files(directory):
        frontmatter = index_frontmatter(ctx, path)
        lines.append(
            f"| [{table_cell(str(frontmatter.get('title') or path.stem))}]({markdown_link_destination(path.name)}) | "
            f"{table_cell(str(frontmatter.get('type') or 'artifact'))} | {table_cell(index_updated(frontmatter))} |"
        )
    project_files = output_project_why_files(directory)
    if project_files:
        lines.extend(["", "## Projects", "", "| Project | Goal |", "|---------|------|"])
        for path in project_files:
            text = path.read_text(encoding="utf-8", errors="replace")
            title_match = re.search(r"(?m)^#\s+(.+)$", text)
            title = title_match.group(1) if title_match else path.parent.name
            lines.append(
                f"| [{table_cell(title)}]({markdown_link_destination(path.relative_to(directory).as_posix())}) | "
                f"{table_cell(first_body_summary(text))} |"
            )
    return "\n".join(lines) + "\n"


def render_dataset_index(ctx: LintContext, directory: Path, contract: str) -> str:
    lines = render_direct_file_index(ctx, directory, contract).rstrip().splitlines()
    navigation = [
        name for name in ("samples", "profiles", "queries")
        if (directory / name / "_index.md").exists()
    ]
    if navigation:
        lines.extend(["", "## Quick Navigation", ""])
        lines.extend(f"- [{name.title()}]({name}/_index.md)" for name in navigation)
    return "\n".join(lines) + "\n"


def render_direct_file_index(ctx: LintContext, directory: Path, contract: str) -> str:
    rows: list[str] = []
    for path in index_contract_entries(directory, "direct-files"):
        frontmatter = index_frontmatter(ctx, path)
        rows.append(
            f"| [{table_cell(str(frontmatter.get('title') or path.stem))}]({markdown_link_destination(path.name)}) | "
            f"{table_cell(str(frontmatter.get('summary') or ''))} | "
            f"{table_cell(', '.join(as_string_list(frontmatter.get('tags'))))} | "
            f"{table_cell(index_updated(frontmatter))} |"
        )
    return (
        f"# {index_title(directory)}\n\n"
        "> Generated by local llm-wiki lint.\n\n"
        f"Last updated: {today_date().isoformat()}\n\n"
        "## Contents\n\n"
        "| File | Summary | Tags | Updated |\n"
        "|------|---------|------|---------|\n"
        + "\n".join(rows)
        + ("\n" if rows else "")
    )


def index_updated(frontmatter: dict[str, Any]) -> str:
    return str(
        frontmatter.get("updated")
        or frontmatter.get("ingested")
        or frontmatter.get("created")
        or ""
    )


def index_title(directory: Path) -> str:
    name = directory.name
    if name == "wiki":
        return "Wiki Index"
    if name == "raw":
        return "Raw Index"
    return name.replace("-", " ").replace("_", " ").title() + " Index"


def markdown_link_destination(path: str) -> str:
    if any(char.isspace() for char in path) or ")" in path:
        return f"<{path}>"
    return path


def extract_markdown_links(text: str) -> list[str]:
    links: list[str] = []
    for match in re.finditer(r"\]\((<([^>\n]+)>|([^)\n]+))\)", text):
        links.append(match.group(2) or match.group(3))
    return links


def is_local_markdown_link(link: str) -> bool:
    if "://" in link or link.startswith("mailto:"):
        return False
    target = link.split("#", 1)[0]
    return target.endswith(".md")


def resolve_link_target(base_dir: Path, link: str) -> Path:
    target = link.split("#", 1)[0]
    windows_target = windows_absolute_path(target)
    if windows_target is not None:
        return windows_target
    if target.startswith("/"):
        return Path(target)
    return (base_dir / target).resolve()


def check_links(ctx: LintContext) -> None:
    for doc in sorted(ctx.documents.values(), key=lambda item: str(item.path)):
        try:
            rel = doc.path.resolve().relative_to(ctx.root)
        except ValueError:
            continue
        if rel.parts[0] not in {"wiki", "inventory"}:
            continue
        full_text = doc.path.read_text(encoding="utf-8")
        for link in extract_markdown_links(full_text):
            if not is_local_markdown_link(link):
                continue
            target = resolve_link_target(doc.path.parent, link)
            if not target.exists():
                ctx.issue("warning", f"Markdown link points to missing file: {link}.", doc.path)


def check_source_provenance(ctx: LintContext) -> None:
    for doc in sorted(ctx.documents.values(), key=lambda item: str(item.path)):
        try:
            rel = doc.path.resolve().relative_to(ctx.root)
        except ValueError:
            continue
        if rel.parts[0] == "wiki":
            sources = doc.frontmatter.get("sources")
            compiled_from = doc.frontmatter.get("compiled-from")
            if not sources and compiled_from not in {"conversation", "mixed"}:
                ctx.issue(
                    "warning",
                    "Compiled article is missing sources and has no compiled-from exemption.",
                    doc.path,
                )
                continue
            if sources:
                if not isinstance(sources, list):
                    ctx.issue("warning", "sources must be a list.", doc.path)
                    continue
                for source in sources:
                    resolved = resolve_source_ref(ctx, doc.path, str(source), wiki_source=True)
                    if resolved is None:
                        ctx.issue("warning", f"Source reference does not resolve: {source}.", doc.path)
                    elif is_under(resolved, ctx.root / "raw"):
                        ctx.referenced_raw.add(resolved.resolve())
        elif rel.parts[0] == "inventory":
            sources = doc.frontmatter.get("sources")
            if sources and isinstance(sources, list):
                for source in sources:
                    if str(source).startswith(("http://", "https://")):
                        continue
                    resolved = resolve_source_ref(ctx, doc.path, str(source), wiki_source=False)
                    if resolved is None:
                        ctx.issue(
                            "warning",
                            f"Inventory source reference does not resolve: {source}.",
                            doc.path,
                        )
        elif rel.parts[0] == "raw":
            source = doc.frontmatter.get("source")
            if source:
                candidate = raw_source_path_candidate(ctx, doc.path, str(source))
                if candidate is not None and not source_path_exists(candidate):
                    ctx.issue(
                        "warning",
                        f"Raw source reference does not resolve: {source}.",
                        doc.path,
                    )

        if "RETRACTED-SOURCE" in doc.body:
            ctx.issue("warning", "Retracted-source marker remains in the file body.", doc.path)


def fix_source_references(ctx: LintContext) -> None:
    if not ctx.fix:
        return
    changed = False
    for doc in sorted(ctx.documents.values(), key=lambda item: str(item.path)):
        try:
            rel = doc.path.resolve().relative_to(ctx.root)
        except ValueError:
            continue
        if rel.parts[0] != "wiki":
            continue
        sources = doc.frontmatter.get("sources")
        if not isinstance(sources, list) or not sources:
            continue
        new_sources: list[str] = []
        doc_changed = False
        for source in sources:
            source_text = str(source)
            resolved = resolve_source_ref(ctx, doc.path, source_text, wiki_source=True)
            if resolved is not None and is_under(resolved, ctx.root / "raw"):
                canonical = ctx.rel(resolved)
                new_sources.append(canonical)
                if canonical != strip_matching_quotes(source_text.strip()):
                    doc_changed = True
            else:
                new_sources.append(source_text)
        if not doc_changed:
            continue
        text = doc.path.read_text(encoding="utf-8")
        parts = split_markdown_frontmatter(text)
        if parts is None:
            continue
        frontmatter, body = parts
        frontmatter = set_frontmatter_list(frontmatter, "sources", new_sources)
        write_markdown_frontmatter(doc.path, frontmatter, body)
        ctx.fixed(f"Rewrote source refs in {ctx.rel(doc.path)}.")
        changed = True
    if changed:
        load_documents(ctx)


def resolve_source_ref(ctx: LintContext, owner: Path, ref: str, wiki_source: bool) -> Path | None:
    ref = strip_matching_quotes(ref.strip())
    if ref.startswith(("http://", "https://")):
        return None if wiki_source else Path(ref)
    candidates: list[Path] = []
    windows_ref = windows_absolute_path(ref)
    ref_path = windows_ref or Path(ref)
    if windows_ref is not None or ref_path.is_absolute():
        candidates.append(ref_path)
    elif ref.startswith(("../", "./")):
        candidates.append((owner.parent / ref).resolve())
    else:
        candidates.append((ctx.root / ref).resolve())
    for candidate in candidates:
        if candidate.exists() and candidate.is_file():
            return candidate.resolve()

    if wiki_source:
        slug = slugify(Path(ref).stem)
        exact_matches: list[Path] = []
        contains_matches: list[Path] = []
        for raw_file in content_markdown_files(ctx.root / "raw"):
            raw_slug = slugify(raw_file.stem)
            raw_slug_without_date = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", raw_slug)
            if slug in {raw_slug, raw_slug_without_date}:
                exact_matches.append(raw_file.resolve())
            elif len(slug) >= 8 and (
                slug in raw_slug_without_date or raw_slug_without_date in slug
            ):
                contains_matches.append(raw_file.resolve())
        if len(exact_matches) == 1:
            return exact_matches[0]
        if len(exact_matches) > 1:
            ctx.issue("warning", f"Source reference is ambiguous after slug fallback: {ref}.", owner)
            return None
        if len(contains_matches) == 1:
            return contains_matches[0]
        if len(contains_matches) > 1:
            ctx.issue("warning", f"Source reference is ambiguous after fuzzy slug fallback: {ref}.", owner)
            return None
    return None


def raw_source_path_candidate(ctx: LintContext, owner: Path, ref: str) -> Path | None:
    """Return a candidate only when a raw source value is clearly a local path.

    Raw provenance also uses sentinels such as ``session`` and descriptive
    labels. Treating every non-HTTP value as a path would make those established
    values fail lint. URI schemes remain external except for ``file://``; bare
    relative paths must contain a separator and no whitespace to be considered
    unambiguous.
    """
    ref = strip_matching_quotes(ref.strip())
    if not ref:
        return None

    windows_ref = windows_absolute_path(ref)
    if windows_ref is not None:
        return windows_ref

    try:
        parsed = urllib.parse.urlsplit(ref)
    except ValueError:
        parsed = None
    if parsed is not None and parsed.scheme:
        # Do not mistake a Windows drive letter for a URI scheme on a platform
        # where Windows paths are not native.
        if WINDOWS_ABSOLUTE_PATH_RE.match(ref):
            return Path(ref)
        if parsed.scheme.lower() != "file":
            return None
        path_text = urllib.parse.unquote(parsed.path)
        if parsed.netloc and parsed.netloc.lower() != "localhost":
            path_text = f"//{parsed.netloc}{path_text}"
        if os.name == "nt" and re.match(r"^/[A-Za-z]:/", path_text):
            path_text = path_text[1:]
        file_path = Path(path_text)
        return file_path if file_path.is_absolute() else ctx.root / file_path

    if SCHEMELESS_WEB_SOURCE_RE.match(ref):
        return None

    explicit_relative = ref.startswith(("../", "./", "..\\", ".\\"))
    home_relative = ref == "~" or ref.startswith(("~/", "~\\"))
    absolute = Path(ref).is_absolute()
    unambiguous_bare_relative = (
        not any(char.isspace() for char in ref) and ("/" in ref or "\\" in ref)
    )
    if not (explicit_relative or home_relative or absolute or unambiguous_bare_relative):
        return None

    ref_path = expand_leading_tilde(ref)
    if ref_path.is_absolute():
        return ref_path
    if explicit_relative:
        return owner.parent / ref_path
    return ctx.root / ref_path


def source_path_exists(path: Path) -> bool:
    """Check a source file or directory without crashing on sandbox denials."""
    try:
        return path.exists()
    except OSError:
        return False


def strip_matching_quotes(value: str) -> str:
    if (value.startswith('"') and value.endswith('"')) or (
        value.startswith("'") and value.endswith("'")
    ):
        return value[1:-1]
    return value


def slugify(value: str) -> str:
    value = value.lower().replace("_", "-")
    value = re.sub(r"\s+", "-", value)
    value = re.sub(r"[^a-z0-9-]", "", value)
    value = re.sub(r"-+", "-", value).strip("-")
    return value


def is_under(path: Path, parent: Path) -> bool:
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except ValueError:
        return False


def check_tags(ctx: LintContext) -> None:
    tag_locations: dict[str, list[Path]] = {}
    for doc in ctx.documents.values():
        tags = doc.frontmatter.get("tags")
        if isinstance(tags, list):
            for tag in tags:
                tag_locations.setdefault(str(tag), []).append(doc.path)

    alias_groups = [
        {"ml", "machine-learning", "machinelearning"},
        {"ai", "artificial-intelligence", "artificialintelligence"},
        {"llm", "llms", "large-language-models"},
    ]
    present = set(tag_locations)
    for group in alias_groups:
        matches = sorted(group & present)
        if len(matches) > 1:
            ctx.issue("warning", f"Near-duplicate tags found: {', '.join(matches)}.")


def check_coverage(ctx: LintContext) -> None:
    unreferenced: list[Path] = []
    for raw_file in content_markdown_files(ctx.root / "raw"):
        doc = ctx.documents.get(raw_file.resolve())
        if doc and "collection-manifest" in as_string_list(doc.frontmatter.get("tags")):
            continue
        if raw_file.resolve() not in ctx.referenced_raw:
            unreferenced.append(raw_file)
    if ctx.fix and unreferenced:
        create_or_update_coverage_reference(ctx, unreferenced)
        return
    for raw_file in unreferenced:
        ctx.issue("suggestion", "Raw source is not referenced by any compiled article.", raw_file)


def create_or_update_coverage_reference(ctx: LintContext, unreferenced: list[Path]) -> None:
    references_dir = ctx.root / "wiki" / "references"
    references_dir.mkdir(parents=True, exist_ok=True)
    coverage_path = references_dir / "uncompiled-source-coverage.md"
    existing_sources: list[Path] = []
    existing_doc = ctx.documents.get(coverage_path.resolve())
    if existing_doc and isinstance(existing_doc.frontmatter.get("sources"), list):
        for source in existing_doc.frontmatter["sources"]:
            resolved = resolve_source_ref(ctx, coverage_path, str(source), wiki_source=True)
            if resolved is not None and is_under(resolved, ctx.root / "raw"):
                existing_sources.append(resolved)

    all_sources = sorted({path.resolve() for path in existing_sources + unreferenced})
    today = today_date().isoformat()
    source_refs = [ctx.rel(path) for path in all_sources]
    rows: list[str] = []
    for raw_file in all_sources:
        doc = ctx.documents.get(raw_file.resolve())
        frontmatter = doc.frontmatter if doc else {}
        title = str(frontmatter.get("title") or raw_file.stem)
        summary = str(frontmatter.get("summary") or "")
        tags = ", ".join(as_string_list(frontmatter.get("tags")))
        rel_link = markdown_relative_link(references_dir, raw_file)
        rows.append(
            f"| [{table_cell(title)}]({rel_link}) | `{ctx.rel(raw_file)}` | {table_cell(summary)} | {table_cell(tags)} |"
        )

    text = "\n".join(
        [
            "---",
            'title: "Uncompiled Source Coverage"',
            "category: reference",
            "sources:",
            *[f"  - {source_ref}" for source_ref in source_refs],
            f"created: {today}",
            f"updated: {today}",
            f"verified: {today}",
            "tags: [coverage, uncompiled-sources, backlog, lint-repair]",
            "confidence: low",
            "volatility: warm",
            'summary: "Reference backlog for raw sources that existed in the wiki but were not yet referenced by compiled articles during lint repair."',
            "---",
            "",
            "# Uncompiled Source Coverage",
            "",
            "This reference page makes the remaining raw-source coverage gap explicit. These sources are now discoverable from the compiled wiki layer, but they have not all been fully synthesized into concept or topic articles. Treat this as a follow-up compilation backlog, not as evidence that every listed source has been integrated into surrounding articles.",
            "",
            "## Sources Needing Synthesis",
            "",
            "| Source | Path | Raw Summary | Tags |",
            "|--------|------|-------------|------|",
            *rows,
            "",
            "## Next Action",
            "",
            "Compile these sources selectively into existing articles when their claims materially change the wiki, then remove rows whose content is fully integrated elsewhere.",
            "",
        ]
    )
    coverage_path.write_text(text, encoding="utf-8")
    ctx.fixed(f"Updated coverage reference {ctx.rel(coverage_path)}.")
    for raw_file in all_sources:
        ctx.referenced_raw.add(raw_file.resolve())
    load_documents(ctx)
    regenerate_directory_index(ctx, references_dir)


def markdown_relative_link(base_dir: Path, target: Path) -> str:
    rel = Path(os.path.relpath(target, base_dir)).as_posix()
    return markdown_link_destination(rel)


def table_cell(value: str) -> str:
    return re.sub(r"\s+", " ", value).replace("|", "\\|").strip()


def as_string_list(value: Any) -> list[str]:
    if isinstance(value, list):
        return [str(item) for item in value]
    return []


def check_freshness(ctx: LintContext) -> None:
    today = today_date()
    thresholds = {"hot": 30, "warm": 180, "cold": 365}
    for doc in ctx.documents.values():
        try:
            rel = doc.path.resolve().relative_to(ctx.root)
        except ValueError:
            continue
        if rel.parts[0] != "wiki":
            continue
        volatility = doc.frontmatter.get("volatility")
        if volatility is None:
            ctx.issue("info", "Compiled article has no volatility field.", doc.path)
            continue
        if volatility not in thresholds:
            continue
        verified = doc.frontmatter.get("verified") or doc.frontmatter.get("updated")
        verified_date = parse_date(str(verified)) if verified else None
        if not verified_date:
            ctx.issue("warning", "Compiled article has no valid verified/updated date.", doc.path)
            continue
        age = (today - verified_date).days
        if age > thresholds[str(volatility)]:
            ctx.issue(
                "warning",
                f"Compiled article may be stale: {age} days since verification for {volatility} volatility.",
                doc.path,
            )


def parse_date(value: str) -> dt.date | None:
    try:
        return dt.date.fromisoformat(value[:10])
    except ValueError:
        return None


def check_projects(ctx: LintContext) -> None:
    projects = ctx.root / "output" / "projects"
    if not projects.exists():
        return
    for project in sorted(child for child in projects.iterdir() if child.is_dir()):
        why = project / "WHY.md"
        if not why.exists() or not why.read_text(encoding="utf-8", errors="replace").strip():
            ctx.issue("warning", "Project is missing a non-empty WHY.md.", project)
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,39}", project.name) or re.search(
            r"\d{4}-\d{2}-\d{2}", project.name
        ):
            ctx.issue("warning", "Project slug should be lowercase, hyphen-separated, <=40 chars, no dates.", project)


def append_lint_log(ctx: LintContext) -> None:
    if not ctx.fix:
        return
    log = ctx.root / "log.md"
    if not log.exists():
        return
    counts = ctx.counts()
    today = today_date().isoformat()
    entry = (
        f"\n## [{today}] lint | local command: "
        f"{counts['critical']} critical, {counts['warning']} warnings, "
        f"{counts['suggestion']} suggestions, {len(ctx.fixes)} auto-fixed\n"
    )
    with log.open("a", encoding="utf-8") as handle:
        handle.write(entry)


def expand_leading_tilde(value: str) -> Path:
    windows_path = windows_absolute_path(value)
    if windows_path is not None:
        return windows_path
    if value == "~":
        return Path.home()
    if value.startswith("~/"):
        return Path.home() / value[2:]
    return Path(value)


def windows_absolute_path(value: str) -> Path | None:
    normalized = normalize_windows_absolute_path(value)
    if normalized is None:
        return None
    return Path(normalized)


def normalize_windows_absolute_path(
    value: str, platform: str | None = None
) -> str | None:
    """Return a canonical drive path only when Windows semantics apply.

    Keeping recognition separate from ``Path`` construction makes the three
    accepted spellings testable on every development platform. POSIX must not
    reinterpret a valid filename such as ``C:\\notes`` as an absolute path.
    """
    if (platform or os.name) != "nt" or not WINDOWS_ABSOLUTE_PATH_RE.match(value):
        return None
    if value.startswith("/"):
        value = value[1:]
    return value.replace("\\", "/")


def initialized_wiki_root(path: Path) -> bool:
    return (path / "_index.md").exists()


def resolve_hub(args: argparse.Namespace) -> Path:
    if args.hub:
        return expand_leading_tilde(str(args.hub))
    config = Path.home() / ".config" / "llm-wiki" / "config.json"
    if config.exists():
        try:
            data = json.loads(config.read_text(encoding="utf-8"))
        except OSError as exc:
            if is_permission_denied(exc):
                raise SystemExit(permission_denied_message(config, "read hub config", exc)) from exc
            raise SystemExit(f"could not read hub config {config}: {exc}") from exc
        except json.JSONDecodeError as exc:
            raise SystemExit(f"invalid hub config {config}: {exc}") from exc
        hub_path = data.get("hub_path")
        hub_candidate = expand_leading_tilde(str(hub_path)) if hub_path else None
        resolved_path = data.get("resolved_path")
        resolved_candidate = (
            expand_leading_tilde(str(resolved_path)) if resolved_path else None
        )

        if hub_candidate:
            # resolved_path is a convenience cache and may be stale when the
            # config is synced between machines. Prefer the portable hub_path
            # unless it is unavailable and the legacy cache clearly points at
            # an initialized hub.
            if hub_candidate.exists() or not (
                resolved_candidate and initialized_wiki_root(resolved_candidate)
            ):
                return hub_candidate
        if resolved_candidate:
            return resolved_candidate
    fallback = Path.home() / "wiki"
    return fallback


def resolve_registry_path(raw_path: str, hub: Path) -> Path:
    if raw_path in {".", "<HUB>", "HUB"}:
        return hub
    if raw_path.startswith("<HUB>/"):
        return hub / raw_path[len("<HUB>/") :]
    if raw_path.startswith("HUB/"):
        return hub / raw_path[len("HUB/") :]

    path = expand_leading_tilde(raw_path)
    if path.is_absolute():
        return path
    return hub / path


def check_hub_registry(ctx: LintContext) -> None:
    registry = ctx.root / "wikis.json"
    if not registry.exists():
        return
    try:
        data = json.loads(registry.read_text(encoding="utf-8"))
    except OSError as exc:
        if is_permission_denied(exc):
            ctx.issue("critical", permission_denied_message(registry, "read wiki registry", exc), registry)
            return
        ctx.issue("critical", f"Could not read wiki registry: {exc}", registry)
        return
    except json.JSONDecodeError as exc:
        ctx.issue("critical", f"Invalid wiki registry: {exc}", registry)
        return

    changed = False
    default_path = data.get("default")
    if isinstance(default_path, str) and default_path not in {"<HUB>", "HUB", "."}:
        if ctx.fix:
            data["default"] = "<HUB>"
            ctx.fixed("Rewrote hub registry default to <HUB>.")
            changed = True
        else:
            ctx.issue(
                "suggestion",
                "Hub registry default should use the portable <HUB> token.",
                registry,
                fixable=True,
            )

    wikis = data.get("wikis")
    if not isinstance(wikis, dict):
        return
    for slug, entry in sorted(wikis.items()):
        if not isinstance(entry, dict):
            continue
        raw_path = entry.get("path")
        if not isinstance(raw_path, str) or not raw_path:
            continue
        if slug == "hub":
            if raw_path not in {"<HUB>", "HUB", "."}:
                if ctx.fix:
                    entry["path"] = "<HUB>"
                    ctx.fixed("Rewrote hub registry entry path to <HUB>.")
                    changed = True
                else:
                    ctx.issue(
                        "suggestion",
                        "Hub registry entry should use portable path <HUB>.",
                        registry,
                        fixable=True,
                    )
            continue

        relative_path = (
            f"topics/.archive/{slug}" if is_archived_registry_entry(entry) else f"topics/{slug}"
        )
        hub_topic = ctx.root / relative_path
        if initialized_wiki_root(hub_topic) and raw_path != relative_path:
            if ctx.fix:
                entry["path"] = relative_path
                ctx.fixed(f"Rewrote hub-owned registry path for {slug} to {relative_path}.")
                changed = True
            else:
                ctx.issue(
                    "suggestion",
                    f"Hub-owned wiki path should be portable: use {relative_path}.",
                    registry,
                    fixable=True,
                )
            continue

        resolved = resolve_registry_path(raw_path, ctx.root)
        if resolved.is_absolute() and not is_under(resolved, ctx.root):
            if resolved.exists():
                ctx.issue(
                    "info",
                    f"Registry path for {slug} is an external local absolute path that exists: {raw_path}.",
                    registry,
                )
            else:
                ctx.issue(
                    "warning",
                    f"Registry path for {slug} is an external local absolute path that does not exist: {raw_path}.",
                    registry,
                )

    if changed:
        write_registry(ctx.root, data)


def is_archived_registry_entry(entry: dict[str, Any] | None) -> bool:
    if not entry:
        return False
    status = str(entry.get("status") or "")
    path = str(entry.get("path") or "")
    return status == "archived" or path.startswith("topics/.archive/")


def read_registry(hub: Path) -> dict[str, Any]:
    registry = hub / "wikis.json"
    try:
        return json.loads(registry.read_text(encoding="utf-8"))
    except OSError as exc:
        if is_permission_denied(exc):
            raise SystemExit(permission_denied_message(registry, "read wiki registry", exc)) from exc
        raise SystemExit(f"could not read wiki registry {registry}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid wiki registry {registry}: {exc}") from exc


def write_registry(hub: Path, data: dict[str, Any]) -> None:
    registry = hub / "wikis.json"
    registry.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n", encoding="utf-8")


def topic_entry(data: dict[str, Any], slug: str) -> dict[str, Any] | None:
    entry = data.get("wikis", {}).get(slug)
    return entry if isinstance(entry, dict) else None


def active_topic_path(hub: Path, slug: str, entry: dict[str, Any] | None = None) -> Path:
    if entry and entry.get("path") and not is_archived_registry_entry(entry):
        return resolve_registry_path(str(entry["path"]), hub)
    return hub / "topics" / slug


def archived_topic_path(hub: Path, slug: str, entry: dict[str, Any] | None = None) -> Path:
    if entry and entry.get("path") and is_archived_registry_entry(entry):
        return resolve_registry_path(str(entry["path"]), hub)
    return hub / "topics" / ".archive" / slug


def is_initialized_topic(path: Path) -> bool:
    return (path / "_index.md").exists() and (path / "config.md").exists()


def resolve_wiki_root(args: argparse.Namespace) -> Path:
    if args.path:
        return expand_leading_tilde(str(args.path))
    if args.local:
        return Path.cwd() / ".wiki"
    hub = resolve_hub(args)
    if args.wiki:
        registry = hub / "wikis.json"
        fallback_topic = hub / "topics" / args.wiki
        fallback_archived_topic = hub / "topics" / ".archive" / args.wiki
        include_archived = bool(getattr(args, "include_archived", False))
        if not registry.exists():
            if initialized_wiki_root(fallback_topic):
                return fallback_topic
            if initialized_wiki_root(fallback_archived_topic):
                if include_archived:
                    return fallback_archived_topic
                raise SystemExit(
                    f"wiki is archived: {args.wiki}. Use --include-archived or restore it first."
                )
            raise SystemExit(f"wiki registry not found: {registry}")
        try:
            data = json.loads(registry.read_text(encoding="utf-8"))
        except OSError as exc:
            if is_permission_denied(exc):
                raise SystemExit(permission_denied_message(registry, "read wiki registry", exc)) from exc
            if initialized_wiki_root(fallback_topic):
                return fallback_topic
            if initialized_wiki_root(fallback_archived_topic):
                if include_archived:
                    return fallback_archived_topic
                raise SystemExit(
                    f"wiki is archived: {args.wiki}. Use --include-archived or restore it first."
                )
            raise SystemExit(f"could not read wiki registry {registry}: {exc}") from exc
        except json.JSONDecodeError as exc:
            if initialized_wiki_root(fallback_topic):
                return fallback_topic
            if initialized_wiki_root(fallback_archived_topic):
                if include_archived:
                    return fallback_archived_topic
                raise SystemExit(
                    f"wiki is archived: {args.wiki}. Use --include-archived or restore it first."
                )
            raise SystemExit(f"invalid wiki registry {registry}: {exc}") from exc
        entry = data.get("wikis", {}).get(args.wiki)
        if not entry or not entry.get("path"):
            if initialized_wiki_root(fallback_topic):
                return fallback_topic
            if initialized_wiki_root(fallback_archived_topic):
                if include_archived:
                    return fallback_archived_topic
                raise SystemExit(
                    f"wiki is archived: {args.wiki}. Use --include-archived or restore it first."
                )
            raise SystemExit(f"wiki not found in registry: {args.wiki}")
        if is_archived_registry_entry(entry) and not include_archived:
            raise SystemExit(
                f"wiki is archived: {args.wiki}. Use --include-archived or restore it first."
            )
        registry_path = resolve_registry_path(str(entry["path"]), hub)
        if (
            not initialized_wiki_root(registry_path)
            and initialized_wiki_root(fallback_topic)
        ):
            return fallback_topic
        if (
            not initialized_wiki_root(registry_path)
            and include_archived
            and initialized_wiki_root(fallback_archived_topic)
        ):
            return fallback_archived_topic
        return registry_path
    local = Path.cwd() / ".wiki"
    if local.exists():
        return local
    return hub


def run_lint(args: argparse.Namespace) -> int:
    root = resolve_wiki_root(args)
    ctx = LintContext(root, fix=args.fix)
    hub_root = is_hub(root)

    check_structure(ctx)
    check_unknown_files(ctx)
    if hub_root:
        check_specialist_library(ctx)
        check_hub_registry(ctx)
        append_lint_log(ctx)
        if args.json:
            print_json_report(ctx)
        else:
            print_text_report(ctx)
        counts = ctx.counts()
        return 1 if counts["critical"] or counts["warning"] or counts["suggestion"] else 0

    load_documents(ctx)
    fix_legacy_wiki_frontmatter(ctx)
    check_frontmatter_schema(ctx)
    check_canonical_placement(ctx)
    load_documents(ctx)
    fix_source_references(ctx)
    check_index_consistency(ctx)
    check_links(ctx)
    check_source_provenance(ctx)
    check_tags(ctx)
    check_coverage(ctx)
    check_freshness(ctx)
    check_projects(ctx)
    append_lint_log(ctx)

    if args.json:
        print_json_report(ctx)
    else:
        print_text_report(ctx)

    counts = ctx.counts()
    return 1 if counts["critical"] or counts["warning"] or counts["suggestion"] else 0


def print_json_report(ctx: LintContext) -> None:
    counts = ctx.counts()
    report = {
        "root": str(ctx.root),
        "status": "pass"
        if not (counts["critical"] or counts["warning"] or counts["suggestion"])
        else "fail",
        "counts": counts,
        "fixes": ctx.fixes,
        "issues": [
            {
                "severity": issue.severity,
                "message": issue.message,
                "path": ctx.rel(issue.path) if issue.path else None,
                "fixable": issue.fixable,
            }
            for issue in sorted(ctx.active_issues(), key=lambda item: item.sort_key())
        ],
    }
    print(json.dumps(report, indent=2, sort_keys=True))


def print_text_report(ctx: LintContext) -> None:
    counts = ctx.counts()
    failed = counts["critical"] or counts["warning"] or counts["suggestion"]
    print(f"llm-wiki lint: {ctx.root}")
    if ctx.fixes:
        print("\nAuto-fixed:")
        for fix in ctx.fixes:
            print(f"- {fix}")
    if failed or counts["info"]:
        print("\nFindings:")
        for issue in sorted(ctx.active_issues(), key=lambda item: item.sort_key()):
            prefix = {
                "critical": "Critical",
                "warning": "Warning",
                "suggestion": "Suggestion",
                "info": "Info",
            }.get(issue.severity, issue.severity.title())
            location = f" ({ctx.rel(issue.path)})" if issue.path else ""
            fixable = " Run again with --fix to apply the safe fix." if issue.fixable and not ctx.fix else ""
            print(f"- {prefix}: {issue.message}{location}{fixable}")
    else:
        print("\nFindings: none")
    print(
        "\nSummary: "
        f"{counts['critical']} critical, {counts['warning']} warnings, "
        f"{counts['suggestion']} suggestions, {counts['info']} info, "
        f"{len(ctx.fixes)} auto-fixed."
    )
    print("Result: " + ("FAIL" if failed else "PASS"))


def append_log(path: Path, operation: str, message: str) -> None:
    log = path / "log.md"
    if not log.exists():
        return
    today = today_date().isoformat()
    with log.open("a", encoding="utf-8") as handle:
        handle.write(f"\n## [{today}] {operation} | {message}\n")


def topic_title(path: Path, slug: str) -> str:
    config = path / "config.md"
    if config.exists():
        try:
            text = config.read_text(encoding="utf-8", errors="replace")
            match = re.search(r'(?m)^title:\s*"?([^"\n]+)"?', text)
            if match:
                return match.group(1).strip()
        except OSError:
            pass
    return slug.replace("-", " ").title()


def write_hub_index(hub: Path, data: dict[str, Any]) -> None:
    today = today_date().isoformat()
    active_rows: list[str] = []
    archived_count = 0
    for slug, entry in sorted(data.get("wikis", {}).items()):
        if slug == "hub":
            continue
        if not isinstance(entry, dict):
            continue
        if is_archived_registry_entry(entry):
            archived_count += 1
            continue
        raw_path = str(entry.get("path") or f"topics/{slug}")
        path = resolve_registry_path(raw_path, hub)
        title = topic_title(path, slug)
        description = str(entry.get("description") or "")
        active_rows.append(
            f"| [{table_cell(slug)}]({markdown_link_destination(raw_path)}) | {table_cell(title)} | {table_cell(description)} |"
        )

    text = "\n".join(
        [
            "# Wiki Hub Index",
            "",
            "> Registry of active topic wikis.",
            "",
            f"Last updated: {today}",
            "",
            "## Statistics",
            "",
            f"- Active topics: {len(active_rows)}",
            f"- Archived topics: {archived_count}",
            "",
            "## Topic Wikis",
            "",
            "| Wiki | Title | Description |",
            "|------|-------|-------------|",
            *active_rows,
            "",
            "## Archive",
            "",
            f"Archived topics are preserved under `topics/.archive/`: {archived_count}",
            "",
        ]
    )
    (hub / "_index.md").write_text(text, encoding="utf-8")


def schema_state_from_text(text: str) -> str:
    parts = split_markdown_frontmatter(text)
    if parts is None:
        return "present"
    frontmatter, _ = parts
    data = parse_frontmatter_block(frontmatter)
    state = data.get("schema_state") or data.get("status")
    return str(state or "present")


def schema_status_payload(root: Path) -> dict[str, Any]:
    schema = root / "schema.md"
    proposals = sorted((root / "output").glob("schema-proposal-*.md")) if (root / "output").exists() else []
    articles = [
        path
        for path in (root / "wiki").glob("**/*.md")
        if path.name != "_index.md"
    ] if (root / "wiki").exists() else []
    if schema.exists():
        try:
            state = schema_state_from_text(schema.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            state = "present"
        status = "present"
    elif proposals:
        state = "proposed"
        status = "missing-with-proposal"
    else:
        state = "missing"
        status = "missing"
    return {
        "root": str(root),
        "status": status,
        "state": state,
        "schema": str(schema),
        "schema_exists": schema.exists(),
        "article_count": len(articles),
        "proposal_count": len(proposals),
        "proposals": [str(path) for path in proposals],
    }


def run_schema(args: argparse.Namespace) -> int:
    root = resolve_wiki_root(args)
    if is_hub(root):
        raise SystemExit("schema operations target a topic wiki, not the hub")
    subcommand = args.schema_command
    if subcommand == "status":
        payload = schema_status_payload(root)
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(f"llm-wiki topic guide: {root}")
            print(f"State: {payload['state']}")
            print(f"Topic guide: {'present' if payload['schema_exists'] else 'missing'} ({payload['schema']})")
            print(f"Articles: {payload['article_count']}")
            print(f"Topic-guide proposals: {payload['proposal_count']}")
            if not payload["schema_exists"]:
                print("Next: llm-wiki schema adopt")
        return 0
    if subcommand == "migrate":
        return schema_migrate(root, apply=args.apply, state=args.state, json_output=args.json, command="migrate")
    if subcommand == "adopt":
        return schema_migrate(
            root,
            apply=not args.dry_run,
            state=args.state,
            json_output=args.json,
            command="adopt",
        )
    raise SystemExit("unknown schema subcommand")


def schema_migrate(root: Path, apply: bool, state: str, json_output: bool = False, command: str = "migrate") -> int:
    if state not in {"advisory", "strict"}:
        raise SystemExit("schema state must be advisory or strict")
    schema = root / "schema.md"
    payload = schema_status_payload(root)
    changed = False
    action = "none"
    if schema.exists():
        action = "already-present"
    elif apply:
        schema.write_text(default_schema_text(root, state=state), encoding="utf-8")
        append_log(root, "schema", f"created starter {state} topic guide schema.md")
        changed = True
        action = "created"
        payload = schema_status_payload(root)
    else:
        action = "would-create"

    result = {
        "root": str(root),
        "schema": str(schema),
        "action": action,
        "changed": changed,
        "command": command,
        "state": payload["state"] if schema.exists() else state,
        "apply": apply,
    }
    if json_output:
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    print(f"llm-wiki schema {command}: {root}")
    if action == "already-present":
        print(f"Topic guide already exists: {schema}")
        print("No changes applied.")
    elif action == "created":
        print(f"Created {state} topic guide: {schema}")
        print("Next: review schema.md, trim unused starter conventions, then run librarian with topic-guide advice.")
    else:
        print(f"Would create default {state} topic guide: {schema}")
        if command == "adopt":
            print("Dry run only. Re-run without --dry-run to write schema.md.")
        else:
            print("Dry run only. Re-run with --apply to write schema.md.")
    return 0


def ensure_hub_for_archive(hub: Path) -> dict[str, Any]:
    if not (hub / "wikis.json").exists() or not (hub / "topics").exists():
        raise SystemExit(f"initialized hub not found: {hub}")
    return read_registry(hub)


def run_archive(args: argparse.Namespace) -> int:
    hub = resolve_hub(args)
    data = ensure_hub_for_archive(hub)
    subcommand = args.archive_command
    if subcommand == "list":
        return archive_list(hub, data, include_archived=args.archived, json_output=args.json)
    if subcommand == "topic":
        return archive_topic(hub, data, args.slug, args.reason)
    if subcommand == "restore":
        return restore_topic(hub, data, args.slug)
    raise SystemExit("unknown archive subcommand")


def archive_list(
    hub: Path,
    data: dict[str, Any],
    include_archived: bool,
    json_output: bool = False,
) -> int:
    active: list[dict[str, str]] = []
    archived: list[dict[str, str]] = []
    for slug, entry in sorted(data.get("wikis", {}).items()):
        if slug == "hub" or not isinstance(entry, dict):
            continue
        path_text = str(entry.get("path") or f"topics/{slug}")
        row = {
            "slug": slug,
            "path": path_text,
            "description": str(entry.get("description") or ""),
            "archived": str(entry.get("archived") or ""),
            "reason": str(entry.get("archive_reason") or ""),
        }
        if is_archived_registry_entry(entry):
            archived.append(row)
        else:
            active.append(row)

    archive_dir = hub / "topics" / ".archive"
    if archive_dir.exists():
        registered = {row["slug"] for row in archived}
        for topic in sorted(child for child in archive_dir.iterdir() if child.is_dir()):
            if topic.name not in registered and initialized_wiki_root(topic):
                archived.append(
                    {
                        "slug": topic.name,
                        "path": f"topics/.archive/{topic.name}",
                        "description": "(missing from registry)",
                        "archived": "",
                        "reason": "registry repair needed",
                    }
                )

    if json_output:
        print(json.dumps({"hub": str(hub), "active": active, "archived": archived}, indent=2))
        return 0

    print(f"llm-wiki archive: {hub}")
    print(f"\nActive topics ({len(active)})")
    print("| Slug | Path | Description |")
    print("|------|------|-------------|")
    for row in active:
        print(f"| {row['slug']} | {row['path']} | {table_cell(row['description'])} |")
    print(f"\nArchived topics: {len(archived)}")
    if include_archived:
        print("\nArchived topics")
        print("| Slug | Path | Archived | Reason |")
        print("|------|------|----------|--------|")
        for row in archived:
            print(
                f"| {row['slug']} | {row['path']} | {row['archived']} | {table_cell(row['reason'])} |"
            )
    elif archived:
        print("Run `llm-wiki archive list --archived` to show archived topics.")
    return 0


def archive_topic(hub: Path, data: dict[str, Any], slug: str, reason: str | None) -> int:
    if slug == "hub":
        raise SystemExit("cannot archive the synthetic hub entry")
    entry = topic_entry(data, slug)
    source = active_topic_path(hub, slug, entry)
    fallback_source = hub / "topics" / slug
    if not initialized_wiki_root(source) and initialized_wiki_root(fallback_source):
        source = fallback_source
    if entry and is_archived_registry_entry(entry):
        raise SystemExit(f"topic already archived: {slug}")
    if not initialized_wiki_root(source):
        raise SystemExit(f"active topic not found: {source}")
    archive_dir = hub / "topics" / ".archive"
    dest = archive_dir / slug
    if dest.exists():
        raise SystemExit(f"archive destination already exists: {dest}")

    wikis = data.setdefault("wikis", {})
    if not isinstance(wikis, dict):
        raise SystemExit("invalid registry: wikis must be an object")

    archive_dir.mkdir(parents=True, exist_ok=True)
    shutil.move(str(source), str(dest))

    entry = wikis.setdefault(slug, {})
    if not isinstance(entry, dict):
        entry = {}
        wikis[slug] = entry
    entry.setdefault("description", topic_title(dest, slug))
    entry["path"] = f"topics/.archive/{slug}"
    entry["status"] = "archived"
    entry["archived"] = today_date().isoformat()
    if reason:
        entry["archive_reason"] = reason
    write_registry(hub, data)
    write_hub_index(hub, data)
    append_log(hub, "archive", f"archived topic {slug}")
    append_log(dest, "archive", f"archived topic {slug}")
    print(f"Archived topic `{slug}`")
    print(f"Old path: {source}")
    print(f"New path: {dest}")
    print(f"Restore with: llm-wiki archive --hub {hub} restore {slug}")
    return 0


def restore_topic(hub: Path, data: dict[str, Any], slug: str) -> int:
    if slug == "hub":
        raise SystemExit("cannot restore the synthetic hub entry")
    entry = topic_entry(data, slug)
    source = archived_topic_path(hub, slug, entry)
    fallback_source = hub / "topics" / ".archive" / slug
    if not initialized_wiki_root(source) and initialized_wiki_root(fallback_source):
        source = fallback_source
    dest = hub / "topics" / slug
    if dest.exists():
        raise SystemExit(f"active topic destination already exists: {dest}")
    if not initialized_wiki_root(source):
        raise SystemExit(f"archived topic not found: {source}")

    wikis = data.setdefault("wikis", {})
    if not isinstance(wikis, dict):
        raise SystemExit("invalid registry: wikis must be an object")

    shutil.move(str(source), str(dest))

    entry = wikis.setdefault(slug, {})
    if not isinstance(entry, dict):
        entry = {}
        wikis[slug] = entry
    entry.setdefault("description", topic_title(dest, slug))
    entry["path"] = f"topics/{slug}"
    entry["status"] = "active"
    entry.pop("archived", None)
    entry.pop("archive_reason", None)
    entry["restored"] = today_date().isoformat()
    write_registry(hub, data)
    write_hub_index(hub, data)
    append_log(hub, "archive", f"restored topic {slug}")
    append_log(dest, "archive", f"restored topic {slug}")
    print(f"Restored topic `{slug}`")
    print(f"Path: {dest}")
    return 0


RETRACTED_MARKER = "[RETRACTED]"
RETRACT_SKIP_NAMES = {".git", ".hg", ".svn"}
RETRACT_LOG_ENTRY_HEADER = re.compile(rb"^## \[\d{4}-\d{2}-\d{2}\] ")


@dataclass
class RetractScan:
    files_scanned: int
    text_matches: list[tuple[Path, int]]
    binary_matches: list[tuple[Path, int]]
    log_entries_matched: int
    name_matches: list[tuple[Path, str]]
    symlink_matches: list[Path]
    skipped_control_paths: list[Path]
    errors: list[str]


def read_retract_value(args: argparse.Namespace) -> bytes:
    if args.stdin:
        value = sys.stdin.buffer.read()
    else:
        value = getpass.getpass("Value to retract: ").encode("utf-8")
    if not value:
        raise SystemExit("retract value is empty")
    if value == RETRACTED_MARKER.encode("utf-8"):
        raise SystemExit("retract value cannot be the replacement marker")
    return value


def retract_patterns(value: bytes, mode: str) -> tuple[list[bytes], list[str]]:
    byte_patterns = {value}
    name_patterns: set[str] = set()
    try:
        text = value.decode("utf-8")
    except UnicodeDecodeError:
        text = ""
    if text:
        name_patterns.add(text)
    if mode == "common" and text and len(value) >= 4:
        encoded = {
            json.dumps(text, ensure_ascii=True)[1:-1],
            urllib.parse.quote(text, safe=""),
            urllib.parse.quote_plus(text, safe=""),
            base64.b64encode(value).decode("ascii"),
            base64.urlsafe_b64encode(value).decode("ascii"),
            value.hex(),
        }
        encoded.update(item.rstrip("=") for item in list(encoded) if item.endswith("="))
        encoded.discard("")
        encoded.discard(text)
        for item in encoded:
            byte_patterns.add(item.encode("utf-8"))
            name_patterns.add(item)
    return (
        sorted(byte_patterns, key=lambda item: (-len(item), item)),
        sorted(name_patterns, key=lambda item: (-len(item), item)),
    )


def registry_retract_roots(hub: Path) -> list[Path]:
    roots = [hub]
    registry = hub / "wikis.json"
    if not registry.exists():
        return roots
    data = read_registry(hub)
    for entry in data.get("wikis", {}).values():
        if isinstance(entry, dict) and entry.get("path"):
            roots.append(resolve_registry_path(str(entry["path"]), hub))
    local_wikis = data.get("local_wikis", [])
    if isinstance(local_wikis, list):
        for entry in local_wikis:
            if isinstance(entry, str):
                roots.append(resolve_registry_path(entry, hub))
            elif isinstance(entry, dict) and entry.get("path"):
                roots.append(resolve_registry_path(str(entry["path"]), hub))
    return roots


def minimize_roots(paths: list[Path]) -> list[Path]:
    selected: list[Path] = []
    for path in paths:
        try:
            candidate = path.expanduser().resolve()
        except OSError:
            candidate = path.expanduser().absolute()
        if any(candidate == root or is_under(candidate, root) for root in selected):
            continue
        selected = [root for root in selected if not is_under(root, candidate)]
        selected.append(candidate)
        selected.sort(key=lambda item: (len(item.parts), str(item)))
    return selected


def resolve_retract_roots(args: argparse.Namespace) -> list[Path]:
    if args.everywhere and (args.path or args.local or args.wiki):
        raise SystemExit("--everywhere cannot be combined with a path, --local, or --wiki")
    if args.everywhere:
        hub = resolve_hub(args)
        roots = registry_retract_roots(hub)
        local = Path.cwd() / ".wiki"
        if local.exists():
            roots.append(local)
    elif args.path:
        roots = [expand_leading_tilde(str(args.path))]
    else:
        # Retraction is allowed to target archived material. Archive state is
        # wiki context, not a mutation gate for this control-plane operation.
        args.include_archived = True
        roots = [resolve_wiki_root(args)]
    roots = minimize_roots(roots)
    if not roots:
        raise SystemExit("no initialized retract scope found")
    return roots


def replace_name(value: str, patterns: list[str]) -> str:
    for pattern in patterns:
        value = value.replace(pattern, RETRACTED_MARKER)
    return value


def sanitized_text(value: str, patterns: list[str]) -> str:
    return replace_name(value, patterns)


def sanitized_error(exc: BaseException, patterns: list[str]) -> str:
    return sanitized_text(str(exc), patterns)


def without_matching_log_entries(data: bytes, patterns: list[bytes]) -> tuple[bytes, int]:
    """Remove structured log entries, or legacy standalone lines, containing a match."""
    kept: list[bytes] = []
    current_entry: list[bytes] = []
    removed = 0

    def flush_entry() -> None:
        nonlocal removed
        if not current_entry:
            return
        entry = b"".join(current_entry)
        if any(pattern in entry for pattern in patterns):
            removed += 1
        else:
            kept.extend(current_entry)
        current_entry.clear()

    for line in data.splitlines(keepends=True):
        if RETRACT_LOG_ENTRY_HEADER.match(line):
            flush_entry()
            current_entry.append(line)
        elif current_entry:
            current_entry.append(line)
        elif any(pattern in line for pattern in patterns):
            # Old or hand-written logs may have content outside structured entries.
            removed += 1
        else:
            kept.append(line)
    flush_entry()
    return b"".join(kept), removed


def scan_retract_roots(
    roots: list[Path], byte_patterns: list[bytes], name_patterns: list[str]
) -> RetractScan:
    text_matches: list[tuple[Path, int]] = []
    binary_matches: list[tuple[Path, int]] = []
    log_entries_matched = 0
    name_matches: list[tuple[Path, str]] = []
    symlink_matches: list[Path] = []
    skipped_control_paths: list[Path] = []
    errors: list[str] = []
    files_scanned = 0

    def walk_error(exc: OSError) -> None:
        path = Path(str(getattr(exc, "filename", "unknown")))
        errors.append(
            f"could not scan {sanitized_text(str(path), name_patterns)}: "
            f"{sanitized_error(exc, name_patterns)}"
        )

    for root in roots:
        if replace_name(root.name, name_patterns) != root.name:
            errors.append(
                "selected retract root name contains a match and must be moved manually: "
                f"{sanitized_text(str(root), name_patterns)}"
            )
        if not root.exists():
            errors.append(f"retract scope does not exist: {sanitized_text(str(root), name_patterns)}")
            continue
        if not root.is_dir():
            errors.append(f"retract scope is not a directory: {sanitized_text(str(root), name_patterns)}")
            continue
        for current, dirnames, filenames in os.walk(root, topdown=True, followlinks=False, onerror=walk_error):
            current_path = Path(current)
            kept_dirs: list[str] = []
            for name in dirnames:
                path = current_path / name
                if name in RETRACT_SKIP_NAMES:
                    skipped_control_paths.append(path)
                    continue
                renamed = replace_name(name, name_patterns)
                if renamed != name:
                    name_matches.append((path, renamed))
                if path.is_symlink():
                    try:
                        target = os.readlink(path)
                        if replace_name(target, name_patterns) != target:
                            symlink_matches.append(path)
                    except OSError as exc:
                        errors.append(
                            f"could not inspect {sanitized_text(str(path), name_patterns)}: "
                            f"{sanitized_error(exc, name_patterns)}"
                        )
                    continue
                kept_dirs.append(name)
            dirnames[:] = kept_dirs

            for name in filenames:
                path = current_path / name
                if name in RETRACT_SKIP_NAMES:
                    skipped_control_paths.append(path)
                    continue
                renamed = replace_name(name, name_patterns)
                if renamed != name:
                    name_matches.append((path, renamed))
                if path.is_symlink():
                    try:
                        target = os.readlink(path)
                        if replace_name(target, name_patterns) != target:
                            symlink_matches.append(path)
                    except OSError as exc:
                        errors.append(
                            f"could not inspect {sanitized_text(str(path), name_patterns)}: "
                            f"{sanitized_error(exc, name_patterns)}"
                        )
                    continue
                try:
                    data = path.read_bytes()
                except OSError as exc:
                    errors.append(
                        f"could not read {sanitized_text(str(path), name_patterns)}: "
                        f"{sanitized_error(exc, name_patterns)}"
                    )
                    continue
                files_scanned += 1
                occurrences = sum(data.count(pattern) for pattern in byte_patterns)
                if not occurrences:
                    continue
                try:
                    data.decode("utf-8")
                    is_text = b"\x00" not in data
                except UnicodeDecodeError:
                    is_text = False
                target = text_matches if is_text else binary_matches
                target.append((path, occurrences))
                if is_text and path.name == "log.md":
                    _, matched_entries = without_matching_log_entries(data, byte_patterns)
                    log_entries_matched += matched_entries

    return RetractScan(
        files_scanned=files_scanned,
        text_matches=text_matches,
        binary_matches=binary_matches,
        log_entries_matched=log_entries_matched,
        name_matches=name_matches,
        symlink_matches=symlink_matches,
        skipped_control_paths=skipped_control_paths,
        errors=errors,
    )


def atomic_replace_patterns(path: Path, patterns: list[bytes]) -> int:
    data = path.read_bytes()
    replacement = RETRACTED_MARKER.encode("utf-8")
    count = 0
    for pattern in patterns:
        found = data.count(pattern)
        if found:
            data = data.replace(pattern, replacement)
            count += found
    if not count:
        return 0
    mode = path.stat().st_mode & 0o7777
    fd, temporary_name = tempfile.mkstemp(prefix=".llm-wiki-retract-", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()
    return count


def atomic_remove_matching_log_entries(path: Path, patterns: list[bytes]) -> int:
    data = path.read_bytes()
    rewritten, removed = without_matching_log_entries(data, patterns)
    if not removed:
        return 0
    mode = path.stat().st_mode & 0o7777
    fd, temporary_name = tempfile.mkstemp(prefix=".llm-wiki-retract-", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(rewritten)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()
    return removed


def apply_retract(
    scan: RetractScan,
    byte_patterns: list[bytes],
    delete_binary_matches: bool,
    remove_from_logs: bool,
    name_patterns: list[str],
) -> tuple[int, int, int, int, list[str]]:
    rewritten = 0
    deleted = 0
    renamed = 0
    log_entries_removed = 0
    errors: list[str] = []
    for path, _ in scan.text_matches:
        try:
            if remove_from_logs and path.name == "log.md":
                removed = atomic_remove_matching_log_entries(path, byte_patterns)
                log_entries_removed += removed
                changed = bool(removed)
            else:
                changed = bool(atomic_replace_patterns(path, byte_patterns))
            if changed:
                rewritten += 1
        except OSError as exc:
            errors.append(
                f"could not rewrite {sanitized_text(str(path), name_patterns)}: "
                f"{sanitized_error(exc, name_patterns)}"
            )
    if delete_binary_matches:
        for path, _ in scan.binary_matches:
            try:
                path.unlink()
                deleted += 1
            except OSError as exc:
                errors.append(
                    f"could not delete {sanitized_text(str(path), name_patterns)}: "
                    f"{sanitized_error(exc, name_patterns)}"
                )

    # Rename deepest entries first so parent renames do not invalidate child paths.
    for path, new_name in sorted(scan.name_matches, key=lambda item: len(item[0].parts), reverse=True):
        if not path.exists() and not path.is_symlink():
            continue
        destination = path.with_name(new_name)
        if destination.exists() or destination.is_symlink():
            errors.append(
                "could not rename "
                f"{sanitized_text(str(path), name_patterns)}: destination already exists"
            )
            continue
        try:
            path.rename(destination)
            renamed += 1
        except OSError as exc:
            errors.append(
                f"could not rename {sanitized_text(str(path), name_patterns)}: "
                f"{sanitized_error(exc, name_patterns)}"
            )
    return rewritten, deleted, renamed, log_entries_removed, errors


def retract_report(
    args: argparse.Namespace,
    roots: list[Path],
    scan: RetractScan,
    name_patterns: list[str],
    rewritten: int = 0,
    deleted: int = 0,
    renamed: int = 0,
    log_entries_removed: int = 0,
    verification: RetractScan | None = None,
) -> dict[str, Any]:
    unresolved_binary = len(scan.binary_matches) if not args.delete_binary_matches else 0
    verification_matches = 0
    verification_errors: list[str] = []
    if verification is not None:
        verification_matches = (
            len(verification.text_matches)
            + len(verification.binary_matches)
            + len(verification.name_matches)
            + len(verification.symlink_matches)
        )
        verification_errors = verification.errors
    errors = scan.errors + verification_errors
    if errors:
        status = "incomplete"
    elif not args.apply:
        status = "dry-run"
    elif unresolved_binary or scan.symlink_matches or verification_matches:
        status = "incomplete"
    else:
        status = "verified"

    matched_paths = {
        sanitized_text(str(path), name_patterns)
        for path, _ in scan.text_matches + scan.binary_matches
    }
    matched_paths.update(
        sanitized_text(str(path), name_patterns) for path, _ in scan.name_matches
    )
    matched_paths.update(sanitized_text(str(path), name_patterns) for path in scan.symlink_matches)
    return {
        "status": status,
        "mode": "apply" if args.apply else "dry-run",
        "scope": [sanitized_text(str(path), name_patterns) for path in roots],
        "files_scanned": scan.files_scanned,
        "text_files_matched": len(scan.text_matches),
        "binary_files_matched": len(scan.binary_matches),
        "log_entries_matched": scan.log_entries_matched,
        "path_names_matched": len(scan.name_matches),
        "symlink_targets_matched": len(scan.symlink_matches),
        "files_rewritten": rewritten,
        "binary_files_deleted": deleted,
        "log_entries_removed": log_entries_removed,
        "paths_renamed": renamed,
        "remove_from_logs": args.remove_from_logs,
        "remaining_matches": verification_matches if verification is not None else None,
        "skipped_version_control_paths": len(scan.skipped_control_paths),
        "matched_paths": sorted(matched_paths),
        "errors": errors,
    }


def print_retract_report(report: dict[str, Any]) -> None:
    print(f"Retraction status: {report['status']}")
    print(f"Mode: {report['mode']}")
    print(f"Files scanned: {report['files_scanned']}")
    print(
        "Matches: "
        f"{report['text_files_matched']} text files, "
        f"{report['binary_files_matched']} binary files, "
        f"{report['log_entries_matched']} log entries, "
        f"{report['path_names_matched']} path names, "
        f"{report['symlink_targets_matched']} symlink targets"
    )
    if report["mode"] == "apply":
        print(
            "Applied: "
            f"{report['files_rewritten']} files rewritten, "
            f"{report['binary_files_deleted']} binary files deleted, "
            f"{report['log_entries_removed']} log entries removed, "
            f"{report['paths_renamed']} paths renamed"
        )
        print(f"Remaining matches: {report['remaining_matches']}")
    if report["matched_paths"]:
        print("Matched paths:")
        for path in report["matched_paths"][:100]:
            print(f"- {path}")
        if len(report["matched_paths"]) > 100:
            print(f"- ... {len(report['matched_paths']) - 100} more")
    if report["skipped_version_control_paths"]:
        print(
            "Boundary: hidden version-control metadata was not scanned or changed "
            f"({report['skipped_version_control_paths']} paths)."
        )
    for error in report["errors"]:
        print(f"Error: {error}", file=sys.stderr)
    if report["mode"] == "dry-run":
        print("Dry run only. Re-run with --apply to write changes.")


def run_retract(args: argparse.Namespace) -> int:
    value = read_retract_value(args)
    byte_patterns, name_patterns = retract_patterns(value, args.variants)
    try:
        roots = resolve_retract_roots(args)
    except SystemExit as exc:
        raise SystemExit(sanitized_text(str(exc), name_patterns)) from exc
    scan = scan_retract_roots(roots, byte_patterns, name_patterns)
    rewritten = deleted = renamed = log_entries_removed = 0
    verification: RetractScan | None = None
    if args.apply:
        rewritten, deleted, renamed, log_entries_removed, apply_errors = apply_retract(
            scan,
            byte_patterns,
            args.delete_binary_matches,
            args.remove_from_logs,
            name_patterns,
        )
        scan.errors.extend(apply_errors)
        if rewritten or deleted or renamed:
            for root in roots:
                try:
                    append_log(
                        root,
                        "retract",
                        "user-directed data retraction; local content updated",
                    )
                    log_path = root / "log.md"
                    if log_path.exists():
                        if args.remove_from_logs:
                            log_entries_removed += atomic_remove_matching_log_entries(
                                log_path, byte_patterns
                            )
                        else:
                            atomic_replace_patterns(log_path, byte_patterns)
                except OSError as exc:
                    scan.errors.append(
                        "could not append operation log at "
                        f"{sanitized_text(str(root), name_patterns)}: "
                        f"{sanitized_error(exc, name_patterns)}"
                    )
        verification = scan_retract_roots(roots, byte_patterns, name_patterns)
    report = retract_report(
        args,
        roots,
        scan,
        name_patterns,
        rewritten=rewritten,
        deleted=deleted,
        renamed=renamed,
        log_entries_removed=log_entries_removed,
        verification=verification,
    )
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print_retract_report(report)
    return 2 if report["status"] == "incomplete" else 0


def specialist_library_path(hub: Path) -> Path:
    return hub / ".skills"


def specialist_registry_path(hub: Path) -> Path:
    return specialist_library_path(hub) / "registry.json"


def empty_specialist_registry() -> dict[str, Any]:
    return {"schema_version": SPECIALIST_REGISTRY_SCHEMA, "topics": {}}


def require_initialized_hub(hub: Path) -> dict[str, Any]:
    if not is_hub(hub) or not (hub / "_index.md").exists() or not (hub / "log.md").exists():
        raise SystemExit(f"initialized hub not found: {hub}")
    return read_registry(hub)


def read_specialist_registry(hub: Path) -> dict[str, Any]:
    path = specialist_registry_path(hub)
    if not path.exists():
        return empty_specialist_registry()
    if path.is_symlink() or not path.is_file():
        raise SystemExit(f"specialist registry must be a regular file: {path}")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        if is_permission_denied(exc):
            raise SystemExit(permission_denied_message(path, "read specialist registry", exc)) from exc
        raise SystemExit(f"could not read specialist registry {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid specialist registry {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SystemExit(f"invalid specialist registry {path}: root must be an object")
    if data.get("schema_version") != SPECIALIST_REGISTRY_SCHEMA:
        raise SystemExit(
            f"unsupported specialist registry schema in {path}: "
            f"expected {SPECIALIST_REGISTRY_SCHEMA}"
        )
    if not isinstance(data.get("topics"), dict):
        raise SystemExit(f"invalid specialist registry {path}: topics must be an object")
    return data


def write_specialist_registry(hub: Path, data: dict[str, Any]) -> None:
    path = specialist_registry_path(hub)
    write_private_json(path, data)


def specialist_frontmatter_value(frontmatter: str, field: str) -> str | None:
    match = re.search(rf"(?m)^{re.escape(field)}\s*:\s*(.*)$", frontmatter)
    if not match:
        return None
    value = match.group(1).strip()
    if value in {">", "|", ">-", "|-"}:
        continuation: list[str] = []
        remainder = frontmatter[match.end() :]
        for line in remainder.splitlines():
            if not line.strip():
                if continuation:
                    continuation.append("")
                continue
            if not line.startswith((" ", "\t")):
                break
            continuation.append(line.strip())
        value = " ".join(part for part in continuation if part)
    if not value:
        return None
    return strip_matching_quotes(value)


def specialist_metadata_value(frontmatter: str, field: str) -> str | None:
    metadata = re.search(r"(?m)^metadata\s*:\s*$", frontmatter)
    if not metadata:
        return None
    remainder = frontmatter[metadata.end() :]
    for line in remainder.splitlines():
        if line and not line.startswith((" ", "\t")):
            break
        match = re.match(rf"\s+{re.escape(field)}\s*:\s*(.+?)\s*$", line)
        if match:
            return strip_matching_quotes(match.group(1).strip())
    return None


def read_specialist_record(path: Path) -> dict[str, Any]:
    text = path.read_text(encoding="utf-8", errors="replace")
    split = split_markdown_frontmatter(text)
    frontmatter, body = split if split is not None else ("", text)
    name = specialist_frontmatter_value(frontmatter, "name") or path.parent.name
    description = specialist_frontmatter_value(frontmatter, "description") or ""
    version = specialist_metadata_value(frontmatter, "version") or ""
    risk_tier = specialist_metadata_value(frontmatter, "risk-tier") or ""
    reviewed = specialist_metadata_value(frontmatter, "reviewed") or ""
    return {
        "name": name,
        "description": description,
        "version": version,
        "risk_tier": risk_tier,
        "reviewed": reviewed,
        "path": str(path),
        "frontmatter": frontmatter,
        "body": body.lstrip("\n"),
        "sha256": file_sha256(path),
    }


def discover_specialists(hub: Path) -> list[dict[str, Any]]:
    library = specialist_library_path(hub)
    if not library.exists():
        return []
    records: list[dict[str, Any]] = []
    for child in sorted(library.iterdir()):
        skill = child / "SKILL.md"
        if (
            child.is_dir()
            and not child.is_symlink()
            and skill.is_file()
            and not skill.is_symlink()
        ):
            records.append(read_specialist_record(skill))
    return records


def enabled_specialist_topics(registry: dict[str, Any], name: str) -> list[str]:
    return sorted(
        topic
        for topic, names in registry.get("topics", {}).items()
        if isinstance(names, list) and name in names
    )


def specialist_rows(hub: Path, registry: dict[str, Any]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    library = specialist_library_path(hub)
    for record in discover_specialists(hub):
        rows.append(
            {
                "name": record["name"],
                "description": record["description"],
                "version": record["version"],
                "risk_tier": record["risk_tier"],
                "reviewed": record["reviewed"],
                "enabled_topics": enabled_specialist_topics(registry, record["name"]),
                "path": str(Path(record["path"]).relative_to(library)),
                "sha256": record["sha256"],
            }
        )
    return rows


def write_specialist_index(hub: Path, registry: dict[str, Any] | None = None) -> None:
    registry = registry or read_specialist_registry(hub)
    library = specialist_library_path(hub)
    library.mkdir(parents=True, exist_ok=True)
    rows = specialist_rows(hub, registry)
    table_rows = [
        "| Specialist | Description | Version | Risk | Enabled topics | Reviewed |",
        "|------------|-------------|---------|------|----------------|----------|",
    ]
    for row in rows:
        topics = ", ".join(row["enabled_topics"]) or "—"
        table_rows.append(
            f"| [{table_cell(row['name'])}]({markdown_link_destination(row['path'])}) "
            f"| {table_cell(row['description'])} | {table_cell(row['version'] or '—')} "
            f"| {table_cell(row['risk_tier'] or '—')} | {table_cell(topics)} "
            f"| {table_cell(row['reviewed'] or '—')} |"
        )
    text = "\n".join(
        [
            "# Specialist Skills Index",
            "",
            "> Personal, instruction-only specialist methods shared across topic wikis.",
            "",
            f"Last updated: {today_date().isoformat()}",
            "",
            "## Contents",
            "",
            *table_rows,
            "",
            "## Safety boundary",
            "",
            "- Specialists are methods and review protocols, not human credentials.",
            "- Topic use is explicit through `registry.json`; no specialist is enabled globally.",
            "- Packages may contain only `SKILL.md` and Markdown under `references/`.",
            "- Loading a specialist never expands the orchestrator's tools or write authority.",
            "- Do not store credentials, case files, health records, customer data, or source corpora here.",
            "",
        ]
    )
    index = library / "_index.md"
    if index.is_symlink():
        raise SystemExit(f"specialist index must not be a symlink: {index}")
    index.write_text(text, encoding="utf-8")


def initialize_specialist_library(hub: Path) -> bool:
    require_initialized_hub(hub)
    library = specialist_library_path(hub)
    if library.exists() and (library.is_symlink() or not library.is_dir()):
        raise SystemExit(f"specialist library must be a real directory: {library}")
    created = not library.exists()
    library.mkdir(parents=True, exist_ok=True)
    registry_path = specialist_registry_path(hub)
    if not registry_path.exists():
        write_specialist_registry(hub, empty_specialist_registry())
        created = True
    registry = read_specialist_registry(hub)
    if not (library / "_index.md").exists():
        created = True
    write_specialist_index(hub, registry)
    return created


def validate_specialist_name(name: str) -> None:
    if len(name) > 64 or not SPECIALIST_NAME_RE.fullmatch(name):
        raise SystemExit(
            "specialist name must be 1-64 lowercase letters, digits, and single hyphens"
        )


def specialist_scaffold(name: str, description: str, risk_tier: str) -> str:
    today = today_date().isoformat()
    return f'''---
name: {name}
description: {yaml_quote(description)}
metadata:
  llm-wiki-kind: specialist
  version: "0.1.0"
  risk-tier: {risk_tier}
  reviewed: "{today}"
---

# Mandate

Define the bounded review or evidence method this specialist applies. Do not
claim a human credential, license, office, degree, or professional authority.

# Non-claims

- This skill is an AI analysis protocol, not a credentialed professional.
- It does not provide professional sign-off or expand the caller's authority.

# Use when

- List concrete task features that should select this specialist.

# Do not use when

- List nearby tasks that need another method or no specialist.

# Required inputs

- Exact question and intended decision or use.
- Bounded evidence packet, source dates, and known missing information.
- Jurisdiction and decision stakes when they materially affect the answer.

# Method

1. Define the ordered analytical procedure.
2. State the domain-specific evidence hierarchy.
3. Test the strongest alternative explanation or downside case.
4. Identify what evidence would change the conclusion.

# Output contract

Return findings, cited evidence, assumptions, uncertainties, counterarguments,
confidence, and recommended next actions. Cite every material factual claim.

# Stop and escalation rules

- Stop when required inputs or current authoritative sources are missing.
- Name the qualified human review required for high-stakes decisions.

# Tool posture

Read-only by default. This skill never grants tools, filesystem access, network
access, subagents, or permission to mutate the wiki or an external system.

# Evaluation cases

- Positive selection case.
- Nearby negative selection case.
- Stale or contradictory evidence case.
- Insufficient-data and escalation case.

# Provenance and maintenance

- Author/reviewer: TODO
- Method sources: TODO
- Review cadence: TODO
- Change notes: 0.1.0 initial scaffold
'''


def validate_specialist_package(
    hub: Path, directory: Path, expected_name: str | None = None
) -> list[dict[str, str]]:
    issues: list[dict[str, str]] = []

    def add(message: str, path: Path = directory) -> None:
        issues.append({"severity": "critical", "message": message, "path": str(path)})

    if directory.is_symlink():
        add("Specialist package must not be a symlink.")
        return issues
    if not directory.is_dir():
        add("Specialist package is not a directory.")
        return issues
    name = expected_name or directory.name
    if len(name) > 64 or not SPECIALIST_NAME_RE.fullmatch(name):
        add("Specialist directory name must be 1-64 lowercase letters, digits, and single hyphens.")
    allowed = {"SKILL.md", "references"}
    for child in sorted(directory.iterdir()):
        if child.name not in allowed:
            add("Instruction-only specialist packages may contain only SKILL.md and references/.", child)
        if child.is_symlink():
            add("Specialist package files and directories must not be symlinks.", child)
    references = directory / "references"
    if references.exists():
        if not references.is_dir() or references.is_symlink():
            add("references must be a real directory.", references)
        else:
            for item in sorted(references.rglob("*")):
                if item.is_symlink():
                    add("Specialist references must not be symlinks.", item)
                elif item.is_file() and item.suffix.lower() != ".md":
                    add("Specialist references must be Markdown files.", item)
                elif item.is_file() and item.stat().st_mode & 0o111:
                    add("Specialist references must not be executable.", item)
    skill = directory / "SKILL.md"
    if not skill.is_file() or skill.is_symlink():
        add("Required SKILL.md is missing or is a symlink.", skill)
        return issues
    if skill.stat().st_mode & 0o111:
        add("SKILL.md must not be executable.", skill)
    try:
        text = skill.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        add(f"SKILL.md must be readable UTF-8 Markdown: {exc}", skill)
        return issues
    split = split_markdown_frontmatter(text)
    if split is None:
        add("SKILL.md requires YAML frontmatter.", skill)
        return issues
    frontmatter, body = split
    declared_name = specialist_frontmatter_value(frontmatter, "name")
    description = specialist_frontmatter_value(frontmatter, "description")
    if declared_name != name:
        add(f"SKILL.md name must match its directory: expected {name!r}.", skill)
    if not description or len(description) > 1024:
        add("SKILL.md description must contain 1-1024 characters.", skill)
    if specialist_metadata_value(frontmatter, "llm-wiki-kind") != "specialist":
        add("metadata.llm-wiki-kind must be specialist.", skill)
    version = specialist_metadata_value(frontmatter, "version")
    if not version or not re.fullmatch(r"\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?", version):
        add("metadata.version must be a semantic version such as 0.1.0.", skill)
    risk_tier = specialist_metadata_value(frontmatter, "risk-tier")
    if risk_tier not in SPECIALIST_RISK_TIERS:
        add("metadata.risk-tier must be low, medium, or high.", skill)
    reviewed = specialist_metadata_value(frontmatter, "reviewed")
    if not reviewed or parse_date(reviewed) is None:
        add("metadata.reviewed must be an ISO date.", skill)
    if re.search(r"(?m)^allowed-tools\s*:", frontmatter):
        add("allowed-tools is not permitted; the llm-wiki orchestrator owns tool authority.", skill)
    headings = set(re.findall(r"(?m)^#\s+(.+?)\s*$", body))
    for section in SPECIALIST_REQUIRED_SECTIONS:
        if section not in headings:
            add(f"Required section is missing: # {section}.", skill)
    return issues


def collect_specialist_issues(hub: Path, name: str | None = None) -> list[dict[str, str]]:
    issues: list[dict[str, str]] = []
    library = specialist_library_path(hub)

    def add(message: str, path: Path) -> None:
        issues.append({"severity": "critical", "message": message, "path": str(path)})

    if not library.exists():
        if name:
            add("Specialist library is not initialized.", library)
        return issues
    if library.is_symlink() or not library.is_dir():
        add(".skills must be a real directory.", library)
        return issues
    if not (library / "_index.md").is_file():
        add("Specialist library _index.md is missing.", library / "_index.md")
    allowed_root_files = {"_index.md", "registry.json"}
    packages: dict[str, Path] = {}
    for child in sorted(library.iterdir()):
        if child.name in allowed_root_files:
            if child.is_symlink() or not child.is_file():
                add("Specialist library control files must be regular files.", child)
            continue
        if not child.is_dir() or child.is_symlink():
            add("Unexpected file in specialist library.", child)
            continue
        packages[child.name] = child
    if name:
        validate_specialist_name(name)
        package = packages.get(name)
        if package is None:
            add(f"Specialist not found: {name}.", library / name)
        else:
            issues.extend(validate_specialist_package(hub, package, name))
    else:
        for package_name, package in packages.items():
            issues.extend(validate_specialist_package(hub, package, package_name))
    registry_path = specialist_registry_path(hub)
    if not registry_path.is_file() or registry_path.is_symlink():
        add("Specialist registry.json is missing or is not a regular file.", registry_path)
        return issues
    try:
        registry = json.loads(registry_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        add(f"Specialist registry.json is invalid: {exc}", registry_path)
        return issues
    if not isinstance(registry, dict) or registry.get("schema_version") != SPECIALIST_REGISTRY_SCHEMA:
        add(f"Specialist registry schema_version must be {SPECIALIST_REGISTRY_SCHEMA}.", registry_path)
        return issues
    topics = registry.get("topics")
    if not isinstance(topics, dict):
        add("Specialist registry topics must be an object.", registry_path)
        return issues
    try:
        wiki_registry = read_registry(hub)
    except SystemExit as exc:
        add(str(exc), hub / "wikis.json")
        return issues
    active_topics = {
        slug
        for slug, entry in wiki_registry.get("wikis", {}).items()
        if slug != "hub" and isinstance(entry, dict) and not is_archived_registry_entry(entry)
    }
    for topic, names in sorted(topics.items()):
        if topic not in active_topics:
            add(f"Specialists are enabled for unknown or archived topic: {topic}.", registry_path)
        if not isinstance(names, list) or any(not isinstance(item, str) for item in names):
            add(f"Specialist allowlist for {topic} must be an array of names.", registry_path)
            continue
        if len(names) != len(set(names)):
            add(f"Specialist allowlist for {topic} contains duplicates.", registry_path)
        for specialist_name in names:
            if specialist_name not in packages:
                add(f"Topic {topic} enables missing specialist: {specialist_name}.", registry_path)
    return issues


def check_specialist_library(ctx: LintContext) -> None:
    if not specialist_library_path(ctx.root).exists():
        return
    for issue in collect_specialist_issues(ctx.root):
        path = Path(issue["path"])
        ctx.issue(issue["severity"], issue["message"], path)


def specialist_init(args: argparse.Namespace) -> int:
    hub = resolve_hub(args)
    created = initialize_specialist_library(hub)
    if created:
        append_log(hub, "specialist", "initialized personal specialist skill library")
    report = {
        "status": "created" if created else "already-initialized",
        "hub": str(hub),
        "library": str(specialist_library_path(hub)),
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        action = "Initialized" if created else "Already initialized"
        print(f"{action}: {specialist_library_path(hub)}")
    return 0


def specialist_create(args: argparse.Namespace) -> int:
    name = args.name
    validate_specialist_name(name)
    description = re.sub(r"\s+", " ", args.description).strip()
    if not description or len(description) > 1024:
        raise SystemExit("specialist description must contain 1-1024 characters")
    hub = resolve_hub(args)
    initialize_specialist_library(hub)
    directory = specialist_library_path(hub) / name
    if directory.exists():
        raise SystemExit(f"specialist already exists: {name}")
    directory.mkdir()
    skill = directory / "SKILL.md"
    skill.write_text(specialist_scaffold(name, description, args.risk_tier), encoding="utf-8")
    registry = read_specialist_registry(hub)
    write_specialist_index(hub, registry)
    append_log(hub, "specialist", f"created personal specialist {name} v0.1.0")
    report = {
        "status": "created",
        "name": name,
        "path": str(skill),
        "risk_tier": args.risk_tier,
        "version": "0.1.0",
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"Created specialist: {skill}")
        print("Next: replace scaffold TODOs, add evaluation cases, then run specialist validate.")
    return 0


def specialist_refresh(args: argparse.Namespace) -> int:
    hub = resolve_hub(args)
    initialize_specialist_library(hub)
    registry = read_specialist_registry(hub)
    write_specialist_index(hub, registry)
    append_log(hub, "specialist", "refreshed personal specialist skill index")
    report = {
        "status": "refreshed",
        "index": str(specialist_library_path(hub) / "_index.md"),
        "specialists": len(discover_specialists(hub)),
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(
            f"Refreshed {report['index']} ({report['specialists']} specialists)."
        )
    return 0


def active_topic_entry(hub: Path, topic: str) -> tuple[dict[str, Any], Path]:
    registry = require_initialized_hub(hub)
    entry = topic_entry(registry, topic)
    if entry is None or is_archived_registry_entry(entry):
        raise SystemExit(f"active topic not found: {topic}")
    path = active_topic_path(hub, topic, entry)
    if not is_initialized_topic(path):
        raise SystemExit(f"active topic path is not initialized: {path}")
    return entry, path


def specialist_list(args: argparse.Namespace) -> int:
    hub = resolve_hub(args)
    require_initialized_hub(hub)
    if args.wiki:
        issues = collect_specialist_issues(hub)
        if issues:
            raise SystemExit(
                "specialist library is invalid; run specialist validate before topic selection"
            )
    registry = read_specialist_registry(hub)
    rows = specialist_rows(hub, registry)
    if args.wiki:
        active_topic_entry(hub, args.wiki)
        enabled = set(registry.get("topics", {}).get(args.wiki, []))
        rows = [row for row in rows if row["name"] in enabled]
    report = {"hub": str(hub), "wiki": args.wiki, "specialists": rows}
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return 0
    label = f" enabled for {args.wiki}" if args.wiki else ""
    print(f"Specialists{label}: {len(rows)}")
    for row in rows:
        topics = ", ".join(row["enabled_topics"]) or "not enabled"
        print(
            f"- {row['name']} v{row['version'] or '?'} [{row['risk_tier'] or '?'}] "
            f"— {row['description']} ({topics})"
        )
    return 0


def specialist_show(args: argparse.Namespace) -> int:
    validate_specialist_name(args.name)
    hub = resolve_hub(args)
    require_initialized_hub(hub)
    path = specialist_library_path(hub) / args.name / "SKILL.md"
    if not path.is_file() or path.is_symlink():
        raise SystemExit(f"specialist not found: {args.name}")
    record = read_specialist_record(path)
    registry = read_specialist_registry(hub)
    record["enabled_topics"] = enabled_specialist_topics(registry, record["name"])
    if args.json:
        print(json.dumps(record, indent=2, sort_keys=True))
    else:
        print(path.read_text(encoding="utf-8"), end="")
    return 0


def specialist_validate(args: argparse.Namespace) -> int:
    hub = resolve_hub(args)
    require_initialized_hub(hub)
    issues = collect_specialist_issues(hub, args.name)
    report = {
        "status": "pass" if not issues else "fail",
        "hub": str(hub),
        "specialist": args.name,
        "issues": issues,
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        target = args.name or "library"
        print(f"llm-wiki specialist validate: {target}")
        if issues:
            for issue in issues:
                print(f"- Critical: {issue['message']} ({issue['path']})")
            print(f"Result: FAIL ({len(issues)} findings)")
        else:
            print("Findings: none")
            print("Result: PASS")
    return 1 if issues else 0


def set_specialist_enabled(args: argparse.Namespace, enabled: bool) -> int:
    validate_specialist_name(args.name)
    hub = resolve_hub(args)
    _, topic_path = active_topic_entry(hub, args.wiki)
    if enabled:
        initialize_specialist_library(hub)
        package = specialist_library_path(hub) / args.name
        issues = validate_specialist_package(hub, package, args.name)
        if issues:
            raise SystemExit(
                f"specialist {args.name} is missing or invalid; run specialist validate {args.name}"
            )
    registry = read_specialist_registry(hub)
    topics = registry.setdefault("topics", {})
    names = topics.setdefault(args.wiki, [])
    if not isinstance(names, list):
        raise SystemExit(f"invalid specialist allowlist for topic: {args.wiki}")
    changed = False
    if enabled and args.name not in names:
        names.append(args.name)
        names.sort()
        changed = True
    if not enabled and args.name in names:
        names.remove(args.name)
        changed = True
        if not names:
            topics.pop(args.wiki, None)
    operation = "enabled" if enabled else "disabled"
    if changed:
        write_specialist_registry(hub, registry)
        write_specialist_index(hub, registry)
        append_log(hub, "specialist", f"{operation} {args.name} for topic {args.wiki}")
        append_log(topic_path, "specialist", f"{operation} {args.name}")
    report = {
        "status": operation if changed else "unchanged",
        "name": args.name,
        "wiki": args.wiki,
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        if changed:
            print(f"{operation.title()} {args.name} for {args.wiki}.")
        else:
            print(f"No change: {args.name} is already {operation} for {args.wiki}.")
    return 0


def specialist_enable(args: argparse.Namespace) -> int:
    return set_specialist_enabled(args, True)


def specialist_disable(args: argparse.Namespace) -> int:
    return set_specialist_enabled(args, False)


def run_specialist(args: argparse.Namespace) -> int:
    handlers = {
        "init": specialist_init,
        "create": specialist_create,
        "refresh": specialist_refresh,
        "list": specialist_list,
        "show": specialist_show,
        "validate": specialist_validate,
        "enable": specialist_enable,
        "disable": specialist_disable,
    }
    return handlers[args.specialist_command](args)


def adapter_config_dir() -> Path:
    override = os.environ.get("LLM_WIKI_CONFIG_DIR")
    if override:
        return expand_leading_tilde(override)
    return Path.home() / ".config" / "llm-wiki"


def adapter_registry_path() -> Path:
    return adapter_config_dir() / "adapters.json"


def empty_adapter_registry() -> dict[str, Any]:
    return {"schema_version": ADAPTER_REGISTRY_SCHEMA, "adapters": {}}


def read_adapter_registry() -> dict[str, Any]:
    path = adapter_registry_path()
    if not path.exists():
        return empty_adapter_registry()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise SystemExit(f"could not read adapter registry {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid adapter registry {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SystemExit(f"invalid adapter registry {path}: root must be an object")
    if data.get("schema_version") != ADAPTER_REGISTRY_SCHEMA:
        raise SystemExit(
            f"unsupported adapter registry schema in {path}: "
            f"expected {ADAPTER_REGISTRY_SCHEMA}"
        )
    if not isinstance(data.get("adapters"), dict):
        raise SystemExit(f"invalid adapter registry {path}: adapters must be an object")
    return data


def write_adapter_registry(data: dict[str, Any]) -> None:
    path = adapter_registry_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        path.parent.chmod(0o700)
    except OSError:
        pass
    handle = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=path.parent,
        prefix=f".{path.name}.",
        suffix=".tmp",
        delete=False,
    )
    temporary = Path(handle.name)
    try:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
        handle.close()
        temporary.chmod(0o600)
        os.replace(temporary, path)
        path.chmod(0o600)
    except Exception:
        handle.close()
        temporary.unlink(missing_ok=True)
        raise


def write_private_json(path: Path, data: dict[str, Any]) -> None:
    """Atomically write a machine-local receipt without broadening permissions."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=path.parent,
        prefix=f".{path.name}.",
        suffix=".tmp",
        delete=False,
    )
    temporary = Path(handle.name)
    try:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
        handle.close()
        temporary.chmod(0o600)
        os.replace(temporary, path)
        path.chmod(0o600)
    except Exception:
        handle.close()
        temporary.unlink(missing_ok=True)
        raise


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_json_object(path: Path, label: str) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise SystemExit(f"could not read {label} {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid {label} {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SystemExit(f"invalid {label} {path}: root must be an object")
    return data


def validate_adapter_routes(
    data: dict[str, Any], path: Path, errors: list[str]
) -> None:
    """Validate optional, provider-neutral intent/resource routing metadata."""
    routes = data.get("routes", [])
    if not isinstance(routes, list):
        errors.append("routes must be an array")
        return
    route_ids: set[str] = set()
    for index, route in enumerate(routes):
        label = f"route {index + 1}"
        if not isinstance(route, dict):
            errors.append(f"{label} must be an object")
            continue
        route_id = route.get("id")
        if not isinstance(route_id, str) or not re.fullmatch(
            r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", route_id
        ):
            errors.append(f"{label} id must be a lowercase hyphenated identifier")
        elif route_id in route_ids:
            errors.append(f"route id {route_id!r} is duplicated")
        else:
            route_ids.add(route_id)
        intents = route.get("intents")
        if not isinstance(intents, list) or not intents or not all(
            isinstance(item, str) and re.fullmatch(r"[a-z][a-z0-9-]*", item)
            for item in intents
        ):
            errors.append(f"{label} intents must be a non-empty lowercase token array")
        elif len(intents) != len(set(intents)):
            errors.append(f"{label} intents must not contain duplicates")
        resource = route.get("resource")
        if not isinstance(resource, dict):
            errors.append(f"{label} resource must be an object")
        else:
            kind = resource.get("kind")
            if kind not in ADAPTER_ROUTE_RESOURCE_KINDS:
                errors.append(f"{label} resource kind must be url")
            schemes = resource.get("schemes")
            if not isinstance(schemes, list) or not schemes or not all(
                isinstance(item, str)
                and item == item.lower()
                and re.fullmatch(r"[a-z][a-z0-9+.-]*", item)
                for item in schemes
            ):
                errors.append(f"{label} URL schemes must be a non-empty lowercase array")
            elif len(schemes) != len(set(schemes)):
                errors.append(f"{label} URL schemes must not contain duplicates")
            hosts = resource.get("hosts")
            if not isinstance(hosts, list) or not hosts or not all(
                isinstance(item, str)
                and item == item.lower()
                and re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?", item)
                for item in hosts
            ):
                errors.append(f"{label} URL hosts must be a non-empty exact-host array")
            elif len(hosts) != len(set(hosts)):
                errors.append(f"{label} URL hosts must not contain duplicates")
            prefixes = resource.get("path_prefixes")
            if not isinstance(prefixes, list) or not prefixes or not all(
                isinstance(item, str)
                and item.startswith("/")
                and "?" not in item
                and "#" not in item
                for item in prefixes
            ):
                errors.append(
                    f"{label} URL path_prefixes must be a non-empty absolute-path array"
                )
            elif len(prefixes) != len(set(prefixes)):
                errors.append(f"{label} URL path_prefixes must not contain duplicates")
        priority = route.get("priority", 0)
        if isinstance(priority, bool) or not isinstance(priority, int) or not 0 <= priority <= 1000:
            errors.append(f"{label} priority must be an integer from 0 to 1000")
        guide = route.get("guide")
        if not isinstance(guide, str) or not guide:
            errors.append(f"{label} guide must be a relative file path")
        else:
            guide_path = Path(guide)
            if guide_path.is_absolute() or ".." in guide_path.parts:
                errors.append(f"{label} guide must stay inside the adapter root")
            else:
                resolved_guide = (path.parent / guide_path).resolve(strict=False)
                if not path_within(resolved_guide, [path.parent.resolve(strict=False)]):
                    errors.append(f"{label} guide must stay inside the adapter root")
                elif not resolved_guide.is_file():
                    errors.append(f"{label} guide does not exist: {guide}")


def validate_adapter_manifest(data: dict[str, Any], path: Path) -> None:
    errors: list[str] = []
    adapter_id = data.get("id")
    if not isinstance(adapter_id, str) or not re.fullmatch(
        r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", adapter_id
    ):
        errors.append("id must be a lowercase hyphenated identifier")
    if data.get("protocol") != ADAPTER_PROTOCOL:
        errors.append(f"protocol must be {ADAPTER_PROTOCOL!r}")
    if not isinstance(data.get("version"), str) or not data.get("version"):
        errors.append("version must be a non-empty string")
    entrypoint = data.get("entrypoint")
    if not isinstance(entrypoint, list) or not entrypoint or not all(
        isinstance(item, str) and item for item in entrypoint
    ):
        errors.append("entrypoint must be a non-empty argv array")
    if data.get("writes_wiki") is not False:
        errors.append("writes_wiki must be false; adapters cannot write into a wiki")
    network = data.get("network", "none")
    if network not in {"none", "optional", "required"}:
        errors.append("network must be none, optional, or required")
    capabilities = data.get("capabilities")
    if not isinstance(capabilities, list) or not capabilities or not all(
        isinstance(item, str) and item for item in capabilities
    ):
        errors.append("capabilities must be a non-empty string array")
    operations = data.get("operations")
    if not isinstance(operations, dict) or not operations:
        errors.append("operations must be a non-empty object")
    else:
        for name, operation in operations.items():
            if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9-]*", name):
                errors.append("operation names must be lowercase hyphenated identifiers")
                continue
            if not isinstance(operation, dict):
                errors.append(f"operation {name!r} must be an object")
                continue
            read_arguments = operation.get("read_arguments", [])
            if not isinstance(read_arguments, list) or not all(
                isinstance(item, str) and item for item in read_arguments
            ):
                errors.append(f"operation {name!r} read_arguments must be a string array")
            if not isinstance(operation.get("requires_output_dir", False), bool):
                errors.append(f"operation {name!r} requires_output_dir must be boolean")
            effects = operation.get("effects", [])
            if not isinstance(effects, list) or not all(
                isinstance(item, str) and item in ADAPTER_REMOTE_EFFECTS
                for item in effects
            ):
                errors.append(
                    f"operation {name!r} effects must contain only remote-read "
                    "and/or remote-write"
                )
                effects = []
            elif len(effects) != len(set(effects)):
                errors.append(f"operation {name!r} effects must not contain duplicates")
            remote_arguments = operation.get("remote_resource_arguments", [])
            if not isinstance(remote_arguments, list) or not all(
                isinstance(item, str) and item for item in remote_arguments
            ):
                errors.append(
                    f"operation {name!r} remote_resource_arguments must be a string array"
                )
                remote_arguments = []
            if effects and not remote_arguments:
                errors.append(
                    f"operation {name!r} with remote effects must declare "
                    "remote_resource_arguments"
                )
            approved_plan_argument = operation.get("approved_plan_argument")
            if "remote-write" in effects:
                if operation.get("requires_output_dir") is not True:
                    errors.append(
                        f"operation {name!r} remote-write requires an output directory"
                    )
                if (
                    not isinstance(approved_plan_argument, str)
                    or not approved_plan_argument
                    or approved_plan_argument not in read_arguments
                ):
                    errors.append(
                        f"operation {name!r} remote-write approved_plan_argument must "
                        "name one of its read_arguments"
                    )
            elif approved_plan_argument is not None:
                errors.append(
                    f"operation {name!r} approved_plan_argument is only valid for remote-write"
                )
    output_classes = data.get("output_classes", [])
    if not isinstance(output_classes, list) or not set(output_classes).issubset(
        ADAPTER_ARTIFACT_CLASSES
    ):
        errors.append(
            "output_classes must contain only wiki-safe, private, and/or bulk"
        )
    validate_adapter_routes(data, path, errors)
    if errors:
        raise SystemExit(
            f"invalid adapter manifest {path}: " + "; ".join(sorted(set(errors)))
        )


def read_adapter_manifest(root: Path) -> tuple[Path, dict[str, Any]]:
    path = root / ADAPTER_MANIFEST_NAME
    if not path.is_file():
        raise SystemExit(f"adapter manifest not found: {path}")
    data = load_json_object(path, "adapter manifest")
    validate_adapter_manifest(data, path)
    return path, data


def normalized_absolute_path(value: str) -> Path:
    return expand_leading_tilde(value).resolve(strict=False)


def resolve_adapter_command(root: Path, entrypoint: list[str]) -> list[str]:
    command = list(entrypoint)
    executable = Path(command[0])
    if executable.is_absolute():
        command[0] = os.path.abspath(executable)
    elif "/" in command[0] or command[0].startswith("."):
        # Do not dereference the final executable symlink. Python virtual
        # environments rely on being invoked through .venv/bin/python so the
        # interpreter discovers pyvenv.cfg and its installed dependencies.
        command[0] = os.path.abspath(root / executable)
    else:
        resolved = shutil.which(command[0])
        if resolved:
            command[0] = resolved
    return command


def registered_adapter(registry: dict[str, Any], adapter_id: str) -> dict[str, Any]:
    entry = registry.get("adapters", {}).get(adapter_id)
    if not isinstance(entry, dict):
        raise SystemExit(f"adapter is not registered: {adapter_id}")
    return entry


def path_within(path: Path, roots: list[Path]) -> bool:
    return any(path == root or root in path.parents for root in roots)


def adapter_environment(entry: dict[str, Any]) -> dict[str, str]:
    names = {
        "HOME",
        "LANG",
        "LC_ALL",
        "PATH",
        "SSL_CERT_DIR",
        "SSL_CERT_FILE",
        "SYSTEMROOT",
        "TEMP",
        "TMP",
        "TMPDIR",
    }
    names.update(str(item) for item in entry.get("env_allow", []))
    environment = {name: os.environ[name] for name in names if name in os.environ}
    environment["PYTHONNOUSERSITE"] = "1"
    environment["PYTHONUTF8"] = "1"
    environment["LLM_WIKI_ADAPTER_ROOT"] = str(entry["root"])
    return environment


def run_adapter_process(
    entry: dict[str, Any], arguments: list[str], timeout: int
) -> subprocess.CompletedProcess[str]:
    if timeout <= 0:
        raise SystemExit("adapter timeout must be greater than zero")
    command = [str(item) for item in entry["command"]] + arguments
    try:
        return subprocess.run(
            command,
            cwd=str(entry["root"]),
            env=adapter_environment(entry),
            text=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise SystemExit(f"adapter timed out after {timeout} seconds") from exc
    except OSError as exc:
        raise SystemExit(f"could not execute registered adapter: {exc}") from exc


def adapter_public_entry(adapter_id: str, entry: dict[str, Any]) -> dict[str, Any]:
    return {
        "id": adapter_id,
        "version": entry.get("version"),
        "capabilities": entry.get("capabilities", []),
        "distribution": entry.get("distribution", "private"),
        "network": entry.get("network", "none"),
        "route_count": len(entry.get("routes", [])),
        "remote_resource_count": len(entry.get("remote_resources", [])),
        "root": entry.get("root"),
        "registered_at": entry.get("registered_at"),
    }


def adapter_add(args: argparse.Namespace) -> int:
    root = normalized_absolute_path(args.path)
    if not root.is_dir():
        raise SystemExit(f"adapter root is not a directory: {root}")
    manifest_path, manifest = read_adapter_manifest(root)
    adapter_id = str(manifest["id"])
    registry = read_adapter_registry()
    if adapter_id in registry["adapters"] and not args.replace:
        raise SystemExit(
            f"adapter is already registered: {adapter_id}; use --replace to update it"
        )
    read_roots = {root}
    read_roots.update(normalized_absolute_path(value) for value in args.read_root)
    write_roots = {
        normalized_absolute_path(value) for value in args.write_root
    }
    command = resolve_adapter_command(root, list(manifest["entrypoint"]))
    remote_resources = sorted(set(args.remote_resource))
    for resource in remote_resources:
        if not isinstance(resource, str) or not resource or any(
            character.isspace() for character in resource
        ) or ":" not in resource:
            raise SystemExit(
                "remote resources must be exact non-whitespace values with a scheme prefix"
            )
    entry = {
        "root": str(root),
        "command": command,
        "version": manifest["version"],
        "capabilities": manifest["capabilities"],
        "distribution": manifest.get("distribution", "private"),
        "network": manifest.get("network", "none"),
        "routes": manifest.get("routes", []),
        "read_roots": sorted(str(path) for path in read_roots),
        "write_roots": sorted(str(path) for path in write_roots),
        "remote_resources": remote_resources,
        "env_allow": sorted(set(args.env)),
        "manifest_sha256": file_sha256(manifest_path),
        "registered_at": today_date().isoformat(),
    }
    registry["adapters"][adapter_id] = entry
    write_adapter_registry(registry)
    report = adapter_public_entry(adapter_id, entry)
    report.update(
        {
            "status": "registered",
            "registry": str(adapter_registry_path()),
            "read_roots": entry["read_roots"],
            "write_roots": entry["write_roots"],
            "remote_resource_count": len(entry["remote_resources"]),
        }
    )
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"Registered adapter: {adapter_id} {entry['version']}")
        print(f"Registry: {adapter_registry_path()}")
        print("Trust: explicit local registration; no repository was cloned or published.")
    return 0


def adapter_list(args: argparse.Namespace) -> int:
    registry = read_adapter_registry()
    entries = [
        adapter_public_entry(adapter_id, entry)
        for adapter_id, entry in sorted(registry["adapters"].items())
        if isinstance(entry, dict)
    ]
    if args.json:
        print(json.dumps({"adapters": entries}, indent=2, sort_keys=True))
    elif not entries:
        print("No private adapters registered.")
    else:
        for entry in entries:
            capabilities = ",".join(entry["capabilities"])
            print(
                f"{entry['id']}\t{entry['version']}\t{entry['network']}\t"
                f"{capabilities}\t{entry['root']}"
            )
    return 0


def adapter_show(args: argparse.Namespace) -> int:
    registry = read_adapter_registry()
    entry = registered_adapter(registry, args.adapter_id)
    report = dict(entry)
    report["id"] = args.adapter_id
    report["registry"] = str(adapter_registry_path())
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


def adapter_route_matches(route: dict[str, Any], intent: str, resource: str) -> bool:
    if intent not in route.get("intents", []):
        return False
    resource_spec = route.get("resource")
    if not isinstance(resource_spec, dict):
        return False
    if resource_spec.get("kind") != "url":
        return False
    try:
        parsed = urllib.parse.urlsplit(resource)
        port = parsed.port
    except ValueError:
        return False
    if not parsed.scheme or not parsed.hostname or parsed.username or parsed.password:
        return False
    if port is not None:
        return False
    path = parsed.path or "/"
    schemes = resource_spec.get("schemes")
    hosts = resource_spec.get("hosts")
    prefixes = resource_spec.get("path_prefixes")
    if not all(isinstance(items, list) for items in (schemes, hosts, prefixes)):
        return False
    return (
        parsed.scheme.lower() in schemes
        and parsed.hostname.lower() in hosts
        and any(isinstance(prefix, str) and path.startswith(prefix) for prefix in prefixes)
    )


def adapter_route(args: argparse.Namespace) -> int:
    """Resolve an effect and resource through registered manifest routes."""
    intent = args.intent.strip().lower()
    if not re.fullmatch(r"[a-z][a-z0-9-]*", intent):
        raise SystemExit("route intent must be one lowercase token")
    registry = read_adapter_registry()
    candidates: list[dict[str, Any]] = []
    unavailable: list[dict[str, Any]] = []
    for adapter_id, entry in sorted(registry["adapters"].items()):
        if not isinstance(entry, dict):
            continue
        for route in entry.get("routes", []):
            if not isinstance(route, dict) or not adapter_route_matches(
                route, intent, args.resource
            ):
                continue
            root = Path(str(entry.get("root", ""))).resolve(strict=False)
            manifest_path = root / ADAPTER_MANIFEST_NAME
            if not manifest_path.is_file():
                unavailable.append({
                    "adapter_id": adapter_id,
                    "route_id": route.get("id"),
                    "priority": route.get("priority", 0),
                    "issue": "manifest missing",
                })
                continue
            if file_sha256(manifest_path) != entry.get("manifest_sha256"):
                unavailable.append({
                    "adapter_id": adapter_id,
                    "route_id": route.get("id"),
                    "priority": route.get("priority", 0),
                    "issue": "manifest changed",
                })
                continue
            guide = (root / str(route["guide"])).resolve(strict=False)
            if not guide.is_file() or not path_within(guide, [root]):
                unavailable.append({
                    "adapter_id": adapter_id,
                    "route_id": route.get("id"),
                    "priority": route.get("priority", 0),
                    "issue": "route guide missing",
                })
                continue
            candidates.append(
                {
                    "adapter_id": adapter_id,
                    "route_id": route["id"],
                    "priority": route.get("priority", 0),
                    "guide": str(guide),
                }
            )
    all_matches = candidates + unavailable
    if all_matches:
        highest_priority = max(int(item["priority"]) for item in all_matches)
    else:
        highest_priority = -1
    blocking_unavailable = [
        item for item in unavailable if int(item["priority"]) == highest_priority
    ]
    if blocking_unavailable:
        report = {
            "status": "unavailable",
            "intent": intent,
            "resource_kind": "url",
            "issues": blocking_unavailable,
        }
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print("A matching adapter route is unavailable; run adapter doctor.")
        return 2
    if not candidates:
        report = {
            "status": "no-match",
            "intent": intent,
            "resource_kind": "url",
        }
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print("No registered adapter route matched.")
        return 1
    winners = [
        candidate for candidate in candidates
        if int(candidate["priority"]) == highest_priority
    ]
    if len(winners) != 1:
        report = {
            "status": "ambiguous",
            "intent": intent,
            "resource_kind": "url",
            "matches": winners,
        }
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print("Multiple registered adapter routes matched at the same priority.")
        return 2
    report = {
        "status": "matched",
        "intent": intent,
        "resource_kind": "url",
        **winners[0],
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(
            f"{report['adapter_id']}\t{report['route_id']}\t{report['guide']}"
        )
    return 0


def adapter_doctor(args: argparse.Namespace) -> int:
    registry = read_adapter_registry()
    entry = registered_adapter(registry, args.adapter_id)
    issues: list[str] = []
    root = Path(str(entry.get("root", ""))).resolve(strict=False)
    manifest_path = root / ADAPTER_MANIFEST_NAME
    manifest: dict[str, Any] | None = None
    if not root.is_dir():
        issues.append("registered root is missing")
    elif not manifest_path.is_file():
        issues.append("adapter manifest is missing")
    else:
        try:
            manifest = load_json_object(manifest_path, "adapter manifest")
            validate_adapter_manifest(manifest, manifest_path)
        except SystemExit as exc:
            issues.append(str(exc))
        if file_sha256(manifest_path) != entry.get("manifest_sha256"):
            issues.append("adapter manifest changed; re-register with --replace")
    command = entry.get("command")
    if not isinstance(command, list) or not command:
        issues.append("registered command is invalid")
    elif not Path(str(command[0])).is_file():
        issues.append("registered executable is missing")
    handshake: dict[str, Any] | None = None
    if not issues:
        result = run_adapter_process(entry, ["describe"], args.timeout)
        if result.returncode != 0:
            issues.append(f"describe handshake failed with exit {result.returncode}")
        else:
            try:
                parsed = json.loads(result.stdout)
                handshake = parsed if isinstance(parsed, dict) else None
            except json.JSONDecodeError:
                handshake = None
            if handshake is None:
                issues.append("describe handshake did not return one JSON object")
            else:
                for field in ("protocol", "id", "version", "capabilities"):
                    if manifest is not None and handshake.get(field) != manifest.get(field):
                        issues.append(f"describe handshake disagrees on {field}")
    report = {
        "id": args.adapter_id,
        "status": "healthy" if not issues else "unhealthy",
        "issues": issues,
        "root": str(root),
        "protocol": ADAPTER_PROTOCOL,
        "handshake": handshake,
    }
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"Adapter {args.adapter_id}: {report['status']}")
        for issue in issues:
            print(f"- {issue}")
    return 0 if not issues else 1


def validate_adapter_request(
    request: dict[str, Any], adapter_id: str, manifest: dict[str, Any],
    entry: dict[str, Any], approved_plan_sha256: str | None,
) -> tuple[str, Path | None, dict[str, Any]]:
    if request.get("protocol") != ADAPTER_PROTOCOL:
        raise SystemExit(f"request protocol must be {ADAPTER_PROTOCOL!r}")
    if request.get("adapter_id") != adapter_id:
        raise SystemExit(f"request adapter_id must be {adapter_id!r}")
    operation = request.get("operation")
    operations = manifest["operations"]
    if not isinstance(operation, str) or operation not in operations:
        raise SystemExit(f"request operation is not supported by {adapter_id}")
    arguments = request.get("arguments")
    if not isinstance(arguments, dict):
        raise SystemExit("request arguments must be an object")
    if not isinstance(request.get("options", {}), dict):
        raise SystemExit("request options must be an object")
    read_roots = [Path(value).resolve(strict=False) for value in entry["read_roots"]]
    operation_spec = operations[operation]
    effects = set(operation_spec.get("effects", []))
    for name in operation_spec.get("read_arguments", []):
        raw_path = arguments.get(name)
        if not isinstance(raw_path, str) or not raw_path:
            raise SystemExit(f"request argument {name!r} must be an absolute path")
        path = Path(raw_path)
        if not path.is_absolute():
            raise SystemExit(f"request argument {name!r} must be an absolute path")
        resolved = path.resolve(strict=False)
        if not resolved.exists():
            raise SystemExit(f"request argument {name!r} does not exist")
        if not path_within(resolved, read_roots):
            raise SystemExit(f"request argument {name!r} is outside registered read roots")
    output_dir: Path | None = None
    if operation_spec.get("requires_output_dir", False):
        raw_output = request.get("output_dir")
        if not isinstance(raw_output, str) or not raw_output:
            raise SystemExit("request output_dir must be an absolute path")
        candidate = Path(raw_output)
        if not candidate.is_absolute():
            raise SystemExit("request output_dir must be an absolute path")
        output_dir = candidate.resolve(strict=False)
        write_roots = [Path(value).resolve(strict=False) for value in entry["write_roots"]]
        if not write_roots or not path_within(output_dir, write_roots):
            raise SystemExit("request output_dir is outside registered write roots")
    allowed_remote_resources = set(entry.get("remote_resources", []))
    remote_resources: list[str] = []
    for name in operation_spec.get("remote_resource_arguments", []):
        resource = arguments.get(name)
        if not isinstance(resource, str) or not resource:
            raise SystemExit(f"request argument {name!r} must be a remote resource string")
        if resource not in allowed_remote_resources:
            raise SystemExit(
                f"request argument {name!r} is outside registered remote resources"
            )
        remote_resources.append(resource)
    governance: dict[str, Any] = {
        "effects": sorted(effects),
        "remote_resources": remote_resources,
    }
    remote_write = request.get("remote_write")
    if "remote-write" not in effects:
        if remote_write is not None:
            raise SystemExit("request remote_write is only valid for a remote-write operation")
        if approved_plan_sha256 is not None:
            raise SystemExit(
                "--approve-remote-write is only valid for a remote-write operation"
            )
        return operation, output_dir, governance
    if not isinstance(remote_write, dict):
        raise SystemExit("remote-write request must include a remote_write object")
    plan_sha256 = remote_write.get("plan_sha256")
    if not isinstance(plan_sha256, str) or not re.fullmatch(r"[0-9a-f]{64}", plan_sha256):
        raise SystemExit("remote_write plan_sha256 must be 64 lowercase hex characters")
    plan_argument = operation_spec["approved_plan_argument"]
    plan_path = Path(str(arguments[plan_argument])).resolve(strict=False)
    actual_plan_sha256 = file_sha256(plan_path)
    if plan_sha256 != actual_plan_sha256:
        raise SystemExit("remote_write plan_sha256 does not match the approved plan file")
    if approved_plan_sha256 is None:
        raise SystemExit(
            "remote-write operation requires --approve-remote-write with the exact plan sha256"
        )
    if approved_plan_sha256 != plan_sha256:
        raise SystemExit("--approve-remote-write does not match remote_write plan_sha256")
    idempotency_key = remote_write.get("idempotency_key")
    if (
        not isinstance(idempotency_key, str)
        or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{7,127}", idempotency_key)
    ):
        raise SystemExit(
            "remote_write idempotency_key must be 8-128 safe identifier characters"
        )
    expected_revision = remote_write.get("expected_revision")
    if not isinstance(expected_revision, str) or not expected_revision:
        raise SystemExit("remote_write expected_revision must be a non-empty string")
    governance["remote_write"] = {
        "plan_sha256": plan_sha256,
        "idempotency_key": idempotency_key,
        "expected_revision": expected_revision,
    }
    return operation, output_dir, governance


def validate_adapter_response(
    response: dict[str, Any], adapter_id: str, operation: str,
    manifest: dict[str, Any], entry: dict[str, Any], output_dir: Path | None,
    governance: dict[str, Any],
) -> None:
    if response.get("protocol") != ADAPTER_PROTOCOL:
        raise SystemExit("adapter response has the wrong protocol")
    if response.get("adapter_id") != adapter_id:
        raise SystemExit("adapter response has the wrong adapter_id")
    if response.get("operation") != operation:
        raise SystemExit("adapter response has the wrong operation")
    if response.get("adapter_version") != manifest.get("version"):
        raise SystemExit("adapter response has the wrong adapter_version")
    if response.get("status") not in {"ok", "error"}:
        raise SystemExit("adapter response status must be ok or error")
    if not isinstance(response.get("summary"), dict):
        raise SystemExit("adapter response summary must be an object")
    if response["status"] == "ok" and not isinstance(response.get("run_id"), str):
        raise SystemExit("successful adapter response run_id must be a string")
    if response["status"] == "error":
        errors = response.get("errors")
        if not isinstance(errors, list) or not errors or not all(
            isinstance(item, str) and item for item in errors
        ):
            raise SystemExit("failed adapter response errors must be a non-empty string array")
    artifacts = response.get("artifacts", [])
    if not isinstance(artifacts, list):
        raise SystemExit("adapter response artifacts must be an array")
    allowed_classes = set(manifest.get("output_classes", []))
    write_roots = [Path(value).resolve(strict=False) for value in entry["write_roots"]]
    for artifact in artifacts:
        if not isinstance(artifact, dict):
            raise SystemExit("adapter response artifact must be an object")
        raw_path = artifact.get("path")
        artifact_class = artifact.get("class")
        expected_sha = artifact.get("sha256")
        if not isinstance(raw_path, str) or not raw_path:
            raise SystemExit("adapter response artifact path is missing")
        if artifact_class not in allowed_classes:
            raise SystemExit("adapter response artifact has an undeclared class")
        if not isinstance(expected_sha, str) or not re.fullmatch(r"[0-9a-f]{64}", expected_sha):
            raise SystemExit("adapter response artifact sha256 is invalid")
        candidate = Path(raw_path)
        if not candidate.is_absolute():
            if output_dir is None:
                raise SystemExit("relative adapter artifact requires output_dir")
            candidate = output_dir / candidate
        resolved = candidate.resolve(strict=False)
        if not resolved.is_file():
            raise SystemExit("adapter response artifact does not exist as a file")
        if not path_within(resolved, write_roots):
            raise SystemExit("adapter response artifact is outside registered write roots")
        if output_dir is not None and not path_within(resolved, [output_dir]):
            raise SystemExit("adapter response artifact is outside the request output_dir")
        if file_sha256(resolved) != expected_sha:
            raise SystemExit("adapter response artifact sha256 does not match")
    remote_write = governance.get("remote_write")
    remote_receipt = response.get("remote_receipt")
    if remote_write is None:
        if remote_receipt is not None:
            raise SystemExit(
                "adapter response remote_receipt is only valid for a remote-write operation"
            )
        return
    if remote_receipt is None and response["status"] == "error":
        return
    if not isinstance(remote_receipt, dict):
        raise SystemExit("successful remote-write response must include remote_receipt")
    if remote_receipt.get("resources") != governance["remote_resources"]:
        raise SystemExit("remote receipt resources do not match the approved request")
    if remote_receipt.get("plan_sha256") != remote_write["plan_sha256"]:
        raise SystemExit("remote receipt plan_sha256 does not match the approved request")
    if remote_receipt.get("idempotency_key") != remote_write["idempotency_key"]:
        raise SystemExit("remote receipt idempotency_key does not match the approved request")
    if remote_receipt.get("before_revision") != remote_write["expected_revision"]:
        raise SystemExit("remote receipt before_revision does not match the approved request")
    if not isinstance(remote_receipt.get("after_revision"), str) or not remote_receipt.get(
        "after_revision"
    ):
        raise SystemExit("remote receipt after_revision must be a non-empty string")
    verification = remote_receipt.get("verification")
    if not isinstance(verification, dict):
        raise SystemExit("remote receipt verification must be an object")
    if response["status"] == "ok" and (
        remote_receipt.get("status") != "verified"
        or verification.get("status") != "verified"
    ):
        raise SystemExit("successful remote-write response must be verified")


def redacted_remote_write_report(response: dict[str, Any]) -> dict[str, Any]:
    """Return a content- and identifier-free terminal report for remote writes."""
    receipt = response.get("remote_receipt")
    resource_count = len(receipt.get("resources", [])) if isinstance(receipt, dict) else 0
    return {
        "protocol": response.get("protocol"),
        "adapter_id": response.get("adapter_id"),
        "adapter_version": response.get("adapter_version"),
        "operation": response.get("operation"),
        "status": response.get("status"),
        "artifact_count": len(response.get("artifacts", [])),
        "remote_write": {
            "status": receipt.get("status") if isinstance(receipt, dict) else "failed",
            "resource_count": resource_count,
            "verified": bool(
                isinstance(receipt, dict)
                and isinstance(receipt.get("verification"), dict)
                and receipt["verification"].get("status") == "verified"
            ),
        },
    }


def adapter_run(args: argparse.Namespace) -> int:
    registry = read_adapter_registry()
    entry = registered_adapter(registry, args.adapter_id)
    root = Path(entry["root"]).resolve(strict=False)
    manifest_path, manifest = read_adapter_manifest(root)
    if file_sha256(manifest_path) != entry.get("manifest_sha256"):
        raise SystemExit("adapter manifest changed; re-register with --replace")
    request_path = normalized_absolute_path(args.request)
    request = load_json_object(request_path, "adapter request")
    operation, output_dir, governance = validate_adapter_request(
        request, args.adapter_id, manifest, entry, args.approve_remote_write
    )
    remote_write_operation = "remote-write" in governance.get("effects", [])
    if remote_write_operation and not args.response:
        raise SystemExit("remote-write operation requires --response for a private receipt")
    response_destination: Path | None = None
    if args.response:
        response_destination = normalized_absolute_path(args.response)
        if remote_write_operation:
            write_roots = [Path(value).resolve(strict=False) for value in entry["write_roots"]]
            if not write_roots or not path_within(response_destination, write_roots):
                raise SystemExit("remote-write response receipt is outside registered write roots")
    with tempfile.TemporaryDirectory(prefix="llm-wiki-adapter-") as temporary:
        response_path = Path(temporary) / "response.json"
        result = run_adapter_process(
            entry,
            ["execute", "--request", str(request_path), "--response", str(response_path)],
            args.timeout,
        )
        if not response_path.is_file():
            raise SystemExit(
                f"adapter exited {result.returncode} without a response document"
            )
        response = load_json_object(response_path, "adapter response")
    validate_adapter_response(
        response, args.adapter_id, operation, manifest, entry, output_dir, governance
    )
    if response_destination is not None:
        write_private_json(response_destination, response)
    if args.json:
        report = redacted_remote_write_report(response) if remote_write_operation else response
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(
            f"Adapter {args.adapter_id} {operation}: {response['status']} "
            f"({len(response.get('artifacts', []))} verified artifacts)"
        )
        print("No artifacts were imported into the wiki automatically.")
    if result.returncode != 0 or response["status"] != "ok":
        return 2
    return 0


def adapter_remove(args: argparse.Namespace) -> int:
    registry = read_adapter_registry()
    registered_adapter(registry, args.adapter_id)
    if not args.yes:
        raise SystemExit("adapter remove requires --yes")
    del registry["adapters"][args.adapter_id]
    write_adapter_registry(registry)
    report = {"id": args.adapter_id, "status": "removed"}
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"Removed adapter registration: {args.adapter_id}")
    return 0


def run_adapter(args: argparse.Namespace) -> int:
    handlers = {
        "add": adapter_add,
        "list": adapter_list,
        "show": adapter_show,
        "route": adapter_route,
        "doctor": adapter_doctor,
        "run": adapter_run,
        "remove": adapter_remove,
    }
    return handlers[args.adapter_command](args)


def checkpoint_pattern_specs() -> list[tuple[str, str, str, re.Pattern[str]]]:
    flags = re.IGNORECASE | re.MULTILINE
    return [
        (
            "secret-private-key",
            "critical",
            "Possible private-key material.",
            re.compile(
                r"-----BEGIN (?:(?:[A-Z0-9 ]+ )?PRIVATE KEY|PGP PRIVATE KEY BLOCK)-----",
                flags,
            ),
        ),
        (
            "secret-known-token",
            "critical",
            "Possible service credential or bearer token.",
            re.compile(
                r"(?:\bAKIA[0-9A-Z]{16}\b|\bgh[pousr]_[A-Za-z0-9]{20,}\b|"
                r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b|\bsk-[A-Za-z0-9_-]{16,}\b|"
                r"\bAIza[0-9A-Za-z_-]{25,}\b|\bBearer\s+[A-Za-z0-9._~+/=-]{12,}|"
                r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b)",
                flags,
            ),
        ),
        (
            "secret-assignment",
            "critical",
            "Possible credential assigned to a sensitive field.",
            re.compile(
                r"\b(?:api[_-]?key|private[_-]?key|(?:access|auth|api|refresh)?[_-]?token|"
                r"client[_-]?secret|password|passwd|secret|session[_-]?cookie)\b"
                r"\s*[\"']?\s*[:=]\s*"
                r"[\"']?[A-Za-z0-9_./+=$~-]{8,}",
                flags,
            ),
        ),
        (
            "secret-url-credentials",
            "critical",
            "Possible username/password embedded in a URL.",
            re.compile(r"\b[a-z][a-z0-9+.-]*://[^\s/@:]+:[^\s/@]+@", flags),
        ),
        (
            "personal-email",
            "warning",
            "Email address may identify a person or private account.",
            re.compile(r"(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b"),
        ),
        (
            "personal-account-field",
            "warning",
            "Account or username field may expose an identity.",
            re.compile(
                r"^[ \t]*[\"']?(?:user(?:name)?|login|account(?:[_-]?name)?|handle)"
                r"[\"']?[ \t]*[:=][ \t]*[\"']?@?[A-Za-z0-9_.-]{2,}",
                flags,
            ),
        ),
        (
            "local-home-path",
            "critical",
            "Machine-local home directory path.",
            re.compile(
                r"(?:(?<![:A-Za-z0-9])/Users/[A-Za-z0-9._-]+(?:/|\b)|"
                r"(?<![:A-Za-z0-9])/home/[A-Za-z0-9._-]+(?:/|\b)|"
                r"(?<![:A-Za-z0-9])/root(?:/|\b)|[A-Za-z]:\\Users\\[A-Za-z0-9._ -]+(?:\\|\b))",
                flags,
            ),
        ),
        (
            "local-machine-path",
            "critical",
            "Machine-local volume, temporary, or file URL path.",
            re.compile(
                r"(?:file://|(?:~|\$HOME|\$\{HOME\})/|(?<![:A-Za-z0-9])/Volumes/[^\s/]+(?:/|\b)|"
                r"(?<![:A-Za-z0-9])/private/var/folders/|(?<![:A-Za-z0-9])/(?:tmp|var|etc|opt|srv|mnt|media|workspace|Applications|Library)/[^\s`\"']+)",
                flags,
            ),
        ),
        (
            "remote-login-identity",
            "warning",
            "Remote-login syntax may expose a username or private host.",
            re.compile(r"\b(?:ssh|scp|sftp|rsync)\b[^\n]*\b[A-Za-z0-9._-]+@[A-Za-z0-9._-]+", flags),
        ),
        (
            "local-network-address",
            "warning",
            "Private-network address may reveal local infrastructure.",
            re.compile(
                r"\b(?:10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|"
                r"172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})\b"
            ),
        ),
        (
            "local-hostname",
            "warning",
            "Local hostname may reveal private infrastructure.",
            re.compile(
                r"(?:\b[A-Za-z0-9][A-Za-z0-9-]{0,62}\.local\b|"
                r"\b[A-Za-z0-9][A-Za-z0-9.-]{0,126}\.(?:lan|internal)\b|"
                r"^[ \t]*[\"']?hostname[\"']?[ \t]*[:=][ \t]*[\"']?[^\s\"']+)",
                flags,
            ),
        ),
        (
            "session-transcript",
            "critical",
            "Session or transcript metadata must not enter a checkpoint.",
            re.compile(
                r"(?:transcript[_-]?path|rollout-[^\s]+\.jsonl|\.sessions/(?:digests|feedback)/|"
                r"\b(?:codex|claude):[0-9a-f]{8}-[0-9a-f-]{27,}\b|UserPromptSubmit|PreCompact|PostCompact)",
                flags,
            ),
        ),
        (
            "prompt-conversation-role",
            "warning",
            "Conversation-role content may be copied prompt or transcript text.",
            re.compile(
                r"(?:^[ \t]*(?:system|developer|assistant|user)[ \t]*:[ \t]+\S|"
                r"[\"']role[\"'][ \t]*:[ \t]*[\"'](?:system|developer|assistant|user)[\"'])",
                flags,
            ),
        ),
        (
            "prompt-instruction-marker",
            "warning",
            "Prompt/instruction marker may expose agent instructions.",
            re.compile(
                r"(?:<\|(?:system|user|assistant)\|>|\[INST\]|</?system>|"
                r"AGENTS\.md instructions for|(?:system|developer) prompt[ \t]*:)",
                flags,
            ),
        ),
    ]


def checkpoint_finding(
    category: str,
    severity: str,
    path: str,
    line: int,
    message: str,
    evidence: str,
) -> CheckpointFinding:
    digest = hashlib.sha256(
        "\0".join([category, path, str(line), evidence]).encode("utf-8")
    ).hexdigest()[:16]
    return CheckpointFinding(
        finding_id=f"privacy-{digest}",
        category=category,
        severity=severity,
        path=path,
        line=line,
        message=message,
    )


def scan_checkpoint_text(text: str, rel: str) -> list[CheckpointFinding]:
    findings: list[CheckpointFinding] = []
    for category, severity, message, pattern in checkpoint_pattern_specs():
        for match in pattern.finditer(text):
            line = text.count("\n", 0, match.start()) + 1
            findings.append(
                checkpoint_finding(
                    category,
                    severity,
                    rel,
                    line,
                    message,
                    match.group(0),
                )
            )
    return findings


def checkpoint_file_paths(root: Path, include_report: bool = False) -> list[Path]:
    names = set(CHECKPOINT_REQUIRED_FILES)
    if include_report:
        names.add(CHECKPOINT_REPORT_NAME)
    return [root / name for name in sorted(names) if (root / name).exists() or (root / name).is_symlink()]


def checkpoint_source_key(item: dict[str, Any]) -> str:
    return f"{item.get('wiki', '')}:{item.get('path', '')}"


def checkpoint_word_count(text: str) -> int:
    return len(re.findall(r"\b[\w][\w'-]*\b", text, flags=re.UNICODE))


def checkpoint_coverage_metrics(root: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    inputs = manifest.get("inputs", [])
    source_word_count = sum(
        item.get("words", 0) for item in inputs if isinstance(item, dict)
    )
    knowledge_path = root / "project-knowledge.md"
    try:
        knowledge_text = knowledge_path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        knowledge_text = ""
    knowledge_word_count = checkpoint_word_count(knowledge_text)
    retention_ratio = (
        knowledge_word_count / source_word_count if source_word_count else 0.0
    )
    return {
        "source_word_count": source_word_count,
        "knowledge_word_count": knowledge_word_count,
        "retention_ratio": round(retention_ratio, 4),
        "minimum_retention_ratio": CHECKPOINT_MIN_KNOWLEDGE_RETENTION_RATIO,
    }


def apply_checkpoint_coverage_metrics(root: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    metrics = checkpoint_coverage_metrics(root, manifest)
    if metrics["retention_ratio"] < CHECKPOINT_MIN_KNOWLEDGE_RETENTION_RATIO:
        required_words = math.ceil(
            metrics["source_word_count"] * CHECKPOINT_MIN_KNOWLEDGE_RETENTION_RATIO
        )
        raise SystemExit(
            "project-knowledge.md is too thin for comprehensive mode: "
            f"{metrics['knowledge_word_count']} words for "
            f"{metrics['source_word_count']} selected-source words; "
            f"write at least {required_words} words or reduce the selected scope"
        )
    coverage = manifest["coverage"]
    for key, value in metrics.items():
        coverage[key] = value
    return metrics


def checkpoint_source_access_findings(
    manifest: dict[str, Any], audience: str
) -> list[CheckpointFinding]:
    inputs = manifest.get("inputs")
    if not isinstance(inputs, list):
        return [
            checkpoint_finding(
                "structure-inputs",
                "critical",
                "checkpoint.json",
                1,
                "Manifest inputs must be an array.",
                "inputs-not-array",
            )
        ]
    source_overrides = manifest.get("source_overrides", [])
    override_keys = {
        entry.get("source")
        for entry in source_overrides
        if isinstance(entry, dict)
        and isinstance(entry.get("source"), str)
        and isinstance(entry.get("reason"), str)
        and entry.get("reason", "").strip()
    }
    allowed = {
        "private": {"public", "team", "private"},
        "team": {"public", "team"},
        "public": {"public"},
    }[audience]
    findings: list[CheckpointFinding] = []
    for index, item in enumerate(inputs):
        if not isinstance(item, dict):
            findings.append(
                checkpoint_finding(
                    "structure-input",
                    "critical",
                    "checkpoint.json",
                    1,
                    f"Input {index + 1} must be an object.",
                    f"input-{index}-not-object",
                )
            )
            continue
        access = item.get("access")
        key = checkpoint_source_key(item)
        if access not in {"public", "team", "private", "unknown"}:
            message = f"Input {index + 1} has no valid access classification."
        elif access not in allowed:
            message = f"Input {index + 1} exceeds the declared {audience} audience."
        else:
            continue
        if key in override_keys:
            continue
        findings.append(
            checkpoint_finding(
                "source-access",
                "critical",
                "checkpoint.json",
                1,
                message,
                f"{index}:{key}:{access}:{audience}",
            )
        )
    return findings


def scan_checkpoint_bundle(root: Path, audience: str) -> tuple[list[CheckpointFinding], list[dict[str, str]]]:
    findings: list[CheckpointFinding] = []
    files: list[dict[str, str]] = []
    allowed_names = CHECKPOINT_REQUIRED_FILES | {CHECKPOINT_REPORT_NAME}
    for path in sorted(root.iterdir(), key=lambda item: item.name):
        if path.name in allowed_names:
            continue
        opaque_path = "unexpected-" + hashlib.sha256(path.name.encode("utf-8")).hexdigest()[:12]
        findings.append(
            checkpoint_finding(
                "structure-unexpected-entry",
                "critical",
                opaque_path,
                0,
                "Checkpoint v1 contains an unexpected file or directory; its name is redacted.",
                path.name,
            )
        )
    for required in sorted(CHECKPOINT_REQUIRED_FILES):
        if not (root / required).is_file():
            findings.append(
                checkpoint_finding(
                    "structure-required-file",
                    "critical",
                    required,
                    0,
                    "Required checkpoint file is missing.",
                    required,
                )
            )
    for path in checkpoint_file_paths(root):
        rel = path.relative_to(root).as_posix()
        findings.extend(scan_checkpoint_text(rel, rel))
        if path.is_symlink():
            findings.append(
                checkpoint_finding(
                    "structure-symlink",
                    "critical",
                    rel,
                    0,
                    "Checkpoint bundles may not contain symbolic links.",
                    rel,
                )
            )
            continue
        try:
            size = path.stat().st_size
        except OSError as exc:
            findings.append(
                checkpoint_finding(
                    "structure-unreadable",
                    "critical",
                    rel,
                    0,
                    "Checkpoint file could not be inspected.",
                    f"{rel}:{type(exc).__name__}",
                )
            )
            continue
        if size > CHECKPOINT_MAX_FILE_BYTES:
            findings.append(
                checkpoint_finding(
                    "structure-file-size",
                    "critical",
                    rel,
                    0,
                    "Checkpoint file exceeds the 10 MiB safety limit.",
                    f"{rel}:{size}",
                )
            )
            continue
        if path.suffix.lower() not in {".md", ".json"}:
            findings.append(
                checkpoint_finding(
                    "structure-file-type",
                    "critical",
                    rel,
                    0,
                    "Checkpoint contains a non-Markdown/non-JSON file.",
                    rel,
                )
            )
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as exc:
            findings.append(
                checkpoint_finding(
                    "structure-non-text",
                    "critical",
                    rel,
                    0,
                    "Checkpoint file is unreadable or not UTF-8 text.",
                    f"{rel}:{type(exc).__name__}",
                )
            )
            continue
        files.append({"path": rel, "sha256": file_sha256(path)})
        findings.extend(scan_checkpoint_text(text, rel))

    manifest_path = root / "checkpoint.json"
    if manifest_path.is_file() and not manifest_path.is_symlink():
        try:
            manifest = load_json_object(manifest_path, "checkpoint manifest")
        except SystemExit as exc:
            findings.append(
                checkpoint_finding(
                    "structure-manifest-json",
                    "critical",
                    "checkpoint.json",
                    1,
                    "Checkpoint manifest is not a valid JSON object.",
                    str(exc),
                )
            )
        else:
            findings.extend(checkpoint_source_access_findings(manifest, audience))
    unique = {finding.finding_id: finding for finding in findings}
    return (
        sorted(unique.values(), key=lambda item: (item.path, item.line, item.category, item.finding_id)),
        sorted(files, key=lambda item: item["path"]),
    )


def validate_checkpoint_manifest(manifest: dict[str, Any], audience: str) -> None:
    if manifest.get("schema") != CHECKPOINT_SCHEMA:
        raise SystemExit(f"checkpoint.json schema must be {CHECKPOINT_SCHEMA!r}")
    if audience not in CHECKPOINT_AUDIENCES:
        raise SystemExit("checkpoint audience must be private, team, or public")
    project = manifest.get("project")
    if not isinstance(project, dict) or not isinstance(project.get("slug"), str) or not project.get("slug"):
        raise SystemExit("checkpoint.json project.slug must be a non-empty string")
    if not SPECIALIST_NAME_RE.fullmatch(project["slug"]):
        raise SystemExit("checkpoint.json project.slug must be lowercase hyphenated text")
    if not isinstance(manifest.get("created_at"), str) or not manifest["created_at"].strip():
        raise SystemExit("checkpoint.json created_at must be a non-empty string")
    if not isinstance(manifest.get("scope"), dict):
        raise SystemExit("checkpoint.json scope must be an object")
    if not isinstance(manifest.get("inputs"), list) or not manifest["inputs"]:
        raise SystemExit("checkpoint.json inputs must be an array")
    if not isinstance(manifest.get("gaps"), list):
        raise SystemExit("checkpoint.json gaps must be an array")
    for index, item in enumerate(manifest["inputs"]):
        if not isinstance(item, dict):
            raise SystemExit(f"checkpoint.json input {index + 1} must be an object")
        for field in ("wiki", "path", "sha256", "reason", "access"):
            if not isinstance(item.get(field), str) or not item[field].strip():
                raise SystemExit(f"checkpoint.json input {index + 1} requires {field}")
        if not isinstance(item.get("words"), int) or item["words"] <= 0:
            raise SystemExit(f"checkpoint.json input {index + 1} words must be a positive integer")
        if not re.fullmatch(r"[0-9a-f]{64}", item["sha256"]):
            raise SystemExit(f"checkpoint.json input {index + 1} sha256 must be 64 lowercase hex characters")
        source_path = item["path"]
        if Path(source_path).is_absolute() or ".." in Path(source_path).parts:
            raise SystemExit(f"checkpoint.json input {index + 1} path must be wiki-relative")
    input_keys = [checkpoint_source_key(item) for item in manifest["inputs"]]
    if len(set(input_keys)) != len(input_keys):
        raise SystemExit("checkpoint.json inputs must have unique wiki:path keys")

    coverage = manifest.get("coverage")
    if not isinstance(coverage, dict):
        raise SystemExit("checkpoint.json coverage must be an object")
    if coverage.get("mode") != "comprehensive":
        raise SystemExit("checkpoint.json coverage.mode must be 'comprehensive'")
    source_word_count = sum(item["words"] for item in manifest["inputs"])
    if coverage.get("source_word_count") != source_word_count:
        raise SystemExit("checkpoint.json coverage.source_word_count must equal input words")
    section_map = coverage.get("section_map")
    if not isinstance(section_map, list) or not section_map:
        raise SystemExit("checkpoint.json coverage.section_map must be a non-empty array")
    mapped_sources: set[str] = set()
    valid_input_keys = set(input_keys)
    for index, item in enumerate(section_map):
        if not isinstance(item, dict):
            raise SystemExit(f"checkpoint.json coverage section {index + 1} must be an object")
        if not isinstance(item.get("section"), str) or not item["section"].strip():
            raise SystemExit(f"checkpoint.json coverage section {index + 1} requires section")
        sources = item.get("sources")
        if not isinstance(sources, list) or not sources:
            raise SystemExit(f"checkpoint.json coverage section {index + 1} requires sources")
        if any(not isinstance(source, str) or source not in valid_input_keys for source in sources):
            raise SystemExit(f"checkpoint.json coverage section {index + 1} names an unknown input")
        mapped_sources.update(sources)
    if mapped_sources != valid_input_keys:
        raise SystemExit("checkpoint.json coverage.section_map must account for every input")
    omissions = coverage.get("omissions")
    if not isinstance(omissions, list):
        raise SystemExit("checkpoint.json coverage.omissions must be an array")
    for index, item in enumerate(omissions):
        if not isinstance(item, dict):
            raise SystemExit(f"checkpoint.json coverage omission {index + 1} must be an object")
        if item.get("source") not in valid_input_keys:
            raise SystemExit(f"checkpoint.json coverage omission {index + 1} names an unknown input")
        for field in ("section", "reason"):
            if not isinstance(item.get(field), str) or not item[field].strip():
                raise SystemExit(f"checkpoint.json coverage omission {index + 1} requires {field}")

    source_overrides = manifest.get("source_overrides", [])
    if not isinstance(source_overrides, list):
        raise SystemExit("checkpoint.json source_overrides must be an array")
    input_keys = set(input_keys)
    for index, item in enumerate(source_overrides):
        if not isinstance(item, dict):
            raise SystemExit(f"checkpoint.json source override {index + 1} must be an object")
        if item.get("source") not in input_keys:
            raise SystemExit(f"checkpoint.json source override {index + 1} names an unknown input")
        if not isinstance(item.get("reason"), str) or not item["reason"].strip():
            raise SystemExit(f"checkpoint.json source override {index + 1} requires a reason")


def checkpoint_content_file_hashes(root: Path) -> list[dict[str, str]]:
    values: list[dict[str, str]] = []
    for path in checkpoint_file_paths(root):
        rel = path.relative_to(root).as_posix()
        if rel in {"checkpoint.json", CHECKPOINT_REPORT_NAME}:
            continue
        if path.is_symlink() or not path.is_file():
            continue
        values.append({"path": rel, "sha256": file_sha256(path)})
    return sorted(values, key=lambda item: item["path"])


def checkpoint_manifest_id(manifest: dict[str, Any]) -> str:
    payload = dict(manifest)
    payload.pop("checkpoint_id", None)
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return "sha256:" + hashlib.sha256(encoded.encode("utf-8")).hexdigest()


def checkpoint_report_id(report: dict[str, Any]) -> str:
    payload = dict(report)
    payload.pop("report_id", None)
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return "sha256:" + hashlib.sha256(encoded.encode("utf-8")).hexdigest()


def checkpoint_timestamp() -> str:
    override = os.environ.get("LLM_WIKI_NOW")
    if override:
        return override
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def write_checkpoint_json(path: Path, value: dict[str, Any]) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def checkpoint_finding_json(finding: CheckpointFinding, allowed: bool) -> dict[str, Any]:
    return {
        "id": finding.finding_id,
        "category": finding.category,
        "severity": finding.severity,
        "path": finding.path,
        "line": finding.line,
        "message": finding.message,
        "status": "allowed" if allowed else "blocking",
    }


def validate_override_reason(reason: str | None) -> str:
    value = (reason or "").strip()
    if not value:
        raise SystemExit("--override-reason is required when allowing a source or finding")
    if len(value) > 240 or "\n" in value or "\r" in value:
        raise SystemExit("--override-reason must be one line and no more than 240 characters")
    if scan_checkpoint_text(value, CHECKPOINT_REPORT_NAME):
        raise SystemExit("--override-reason itself matches a sensitive-information pattern")
    return value


def checkpoint_seal(args: argparse.Namespace) -> int:
    root = Path(args.path).expanduser().resolve(strict=False)
    if not root.is_dir():
        raise SystemExit("checkpoint seal path must be an existing directory")
    for name in CHECKPOINT_REQUIRED_FILES | {CHECKPOINT_REPORT_NAME}:
        if (root / name).is_symlink():
            raise SystemExit("checkpoint seal refuses symbolic links in the fixed bundle")
    manifest_path = root / "checkpoint.json"
    manifest = load_json_object(manifest_path, "checkpoint manifest")
    validate_checkpoint_manifest(manifest, args.audience)

    allowed_findings = set(args.allow_finding or [])
    allowed_sources = set(args.allow_source or [])
    reason: str | None = None
    if allowed_findings or allowed_sources:
        reason = validate_override_reason(args.override_reason)

    input_keys = {
        checkpoint_source_key(item)
        for item in manifest.get("inputs", [])
        if isinstance(item, dict)
    }
    unknown_sources = sorted(allowed_sources - input_keys)
    if unknown_sources:
        raise SystemExit("--allow-source names an input not present in checkpoint.json")
    # A new seal never trusts hand-written or stale source overrides. The
    # caller must re-authorize every retained above-audience input by exact key.
    manifest["source_overrides"] = [
        {"source": key, "reason": reason} for key in sorted(allowed_sources)
    ]

    manifest["audience"] = args.audience
    coverage_metrics = apply_checkpoint_coverage_metrics(root, manifest)
    manifest["files"] = checkpoint_content_file_hashes(root)
    manifest["checkpoint_id"] = checkpoint_manifest_id(manifest)
    write_checkpoint_json(manifest_path, manifest)

    findings, scanned_files = scan_checkpoint_bundle(root, args.audience)
    finding_ids = {finding.finding_id for finding in findings}
    unknown_findings = sorted(allowed_findings - finding_ids)
    if unknown_findings:
        raise SystemExit("--allow-finding contains an unknown or stale finding ID")
    blocking = [finding for finding in findings if finding.finding_id not in allowed_findings]
    source_override_count = len(manifest.get("source_overrides", []))
    status = "blocked" if blocking else (
        "overridden" if findings or source_override_count else "passed"
    )
    overrides = [
        {"finding_id": finding_id, "reason": reason}
        for finding_id in sorted(allowed_findings)
    ]
    report: dict[str, Any] = {
        "schema": CHECKPOINT_PRIVACY_SCHEMA,
        "scanner_version": CHECKPOINT_SCANNER_VERSION,
        "checkpoint_id": manifest["checkpoint_id"],
        "audience": args.audience,
        "scanned_at": checkpoint_timestamp(),
        "status": status,
        "files": scanned_files,
        "findings": [
            checkpoint_finding_json(finding, finding.finding_id in allowed_findings)
            for finding in findings
        ],
        "overrides": overrides,
        "source_override_count": source_override_count,
        "coverage": coverage_metrics,
    }
    report["report_id"] = checkpoint_report_id(report)
    write_checkpoint_json(root / CHECKPOINT_REPORT_NAME, report)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(
            f"Checkpoint seal: {status} ({len(scanned_files)} files, "
            f"{len(findings)} findings, {len(overrides)} overrides)"
        )
        for finding in findings:
            print(
                f"- {finding.finding_id} {finding.category} "
                f"{finding.path}:{finding.line} - {finding.message}"
            )
    return 2 if blocking else 0


def checkpoint_verify(args: argparse.Namespace) -> int:
    root = Path(args.path).expanduser().resolve(strict=False)
    errors: list[str] = []
    if not root.is_dir():
        raise SystemExit("checkpoint verify path must be an existing directory")
    for name in CHECKPOINT_REQUIRED_FILES | {CHECKPOINT_REPORT_NAME}:
        if (root / name).is_symlink():
            result = {
                "status": "invalid",
                "errors": ["checkpoint verify refuses symbolic links in the fixed bundle"],
            }
            print(json.dumps(result, indent=2, sort_keys=True) if args.json else result["errors"][0])
            return 2
    try:
        manifest = load_json_object(root / "checkpoint.json", "checkpoint manifest")
        report = load_json_object(root / CHECKPOINT_REPORT_NAME, "checkpoint privacy report")
    except SystemExit as exc:
        result = {"status": "invalid", "errors": [str(exc)]}
        print(json.dumps(result, indent=2, sort_keys=True) if args.json else str(exc))
        return 2
    audience = manifest.get("audience")
    try:
        validate_checkpoint_manifest(manifest, audience)
    except SystemExit as exc:
        errors.append(str(exc))
    if report.get("schema") != CHECKPOINT_PRIVACY_SCHEMA:
        errors.append("privacy-report.json has an unsupported schema")
    if report.get("scanner_version") != CHECKPOINT_SCANNER_VERSION:
        errors.append("privacy-report.json scanner version is unsupported")
    if report.get("report_id") != checkpoint_report_id(report):
        errors.append("privacy-report.json report_id does not match its content")
    expected_checkpoint_id = checkpoint_manifest_id(manifest)
    if manifest.get("checkpoint_id") != expected_checkpoint_id:
        errors.append("checkpoint.json checkpoint_id does not match its content")
    if report.get("checkpoint_id") != manifest.get("checkpoint_id"):
        errors.append("privacy report checkpoint_id does not match checkpoint.json")
    if report.get("audience") != audience:
        errors.append("privacy report audience does not match checkpoint.json")

    coverage_metrics = checkpoint_coverage_metrics(root, manifest)
    coverage = manifest.get("coverage", {})
    for key, value in coverage_metrics.items():
        if coverage.get(key) != value:
            errors.append(f"checkpoint.json coverage {key} does not match the bundle")
    if coverage_metrics["retention_ratio"] < CHECKPOINT_MIN_KNOWLEDGE_RETENTION_RATIO:
        errors.append("project-knowledge.md is too thin for comprehensive mode")
    if report.get("coverage") != coverage_metrics:
        errors.append("privacy report coverage metrics do not match the bundle")

    actual_content_files = checkpoint_content_file_hashes(root)
    if manifest.get("files") != actual_content_files:
        errors.append("checkpoint.json generated-file hashes do not match the bundle")
    findings, scanned_files = scan_checkpoint_bundle(root, audience) if audience in CHECKPOINT_AUDIENCES else ([], [])
    if report.get("files") != scanned_files:
        errors.append("privacy report file hashes do not match the bundle")
    report_finding_ids = {
        item.get("id") for item in report.get("findings", []) if isinstance(item, dict)
    }
    actual_finding_ids = {finding.finding_id for finding in findings}
    if report_finding_ids != actual_finding_ids:
        errors.append("privacy findings do not match a fresh scan")
    override_rows = report.get("overrides")
    if not isinstance(override_rows, list):
        errors.append("privacy report overrides must be an array")
        override_rows = []
    override_ids: set[str] = set()
    for index, item in enumerate(override_rows):
        if not isinstance(item, dict) or not isinstance(item.get("finding_id"), str):
            errors.append(f"privacy report override {index + 1} is invalid")
            continue
        try:
            validate_override_reason(item.get("reason"))
        except SystemExit:
            errors.append(f"privacy report override {index + 1} has an invalid reason")
            continue
        override_ids.add(item["finding_id"])
    if len(override_ids) != len(override_rows):
        errors.append("privacy report overrides contain duplicate or invalid finding IDs")
    if not override_ids.issubset(actual_finding_ids):
        errors.append("privacy report contains an unknown or stale override")
    expected_finding_records = [
        checkpoint_finding_json(finding, finding.finding_id in override_ids)
        for finding in findings
    ]
    if report.get("findings") != expected_finding_records:
        errors.append("privacy report finding metadata does not match a fresh scan")
    blocking_ids = actual_finding_ids - override_ids
    source_override_count = len(manifest.get("source_overrides", []))
    if report.get("source_override_count") != source_override_count:
        errors.append("privacy report source override count does not match checkpoint.json")
    expected_status = "blocked" if blocking_ids else (
        "overridden" if actual_finding_ids or source_override_count else "passed"
    )
    if report.get("status") != expected_status:
        errors.append("privacy report status does not match the current findings")
    result = {
        "schema": CHECKPOINT_PRIVACY_SCHEMA,
        "status": "invalid" if errors else expected_status,
        "checkpoint_id": manifest.get("checkpoint_id"),
        "audience": audience,
        "file_count": len(scanned_files),
        "finding_count": len(findings),
        "override_count": len(override_ids),
        "source_override_count": source_override_count,
        "coverage": coverage_metrics,
        "finding_categories": sorted({finding.category for finding in findings}),
        "errors": errors,
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(
            f"Checkpoint verify: {result['status']} ({result['file_count']} files, "
            f"{result['finding_count']} findings, {result['override_count']} overrides)"
        )
        for error in errors:
            print(f"- {error}")
    return 2 if errors or expected_status == "blocked" else 0


def run_checkpoint(args: argparse.Namespace) -> int:
    handlers = {"seal": checkpoint_seal, "verify": checkpoint_verify}
    return handlers[args.checkpoint_command](args)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="llm-wiki",
        description="Local deterministic helpers for llm-wiki.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    lint = subparsers.add_parser(
        "lint",
        help="Run local structural checks on a wiki root.",
        description=(
            "Run deterministic checks that do not require an LLM. Pass a wiki root "
            "path, or use --local/--wiki to resolve one through the normal hub rules."
        ),
    )
    lint.add_argument("path", nargs="?", help="Wiki root path to lint.")
    lint.add_argument("--fix", action="store_true", help="Apply unambiguous structural fixes.")
    lint.add_argument("--local", action="store_true", help="Lint .wiki/ in the current directory.")
    lint.add_argument("--wiki", help="Named wiki from the hub registry.")
    lint.add_argument("--hub", help="Override hub path for --wiki resolution.")
    lint.add_argument(
        "--include-archived",
        action="store_true",
        help="Allow linting an explicitly targeted archived wiki.",
    )
    lint.add_argument("--json", action="store_true", help="Print a machine-readable JSON report.")
    lint.set_defaults(func=run_lint)

    archive = subparsers.add_parser(
        "archive",
        help="Archive, restore, or list hub topic wikis.",
        description=(
            "Move whole topic wikis between topics/<slug> and topics/.archive/<slug>, "
            "updating wikis.json so archived topics stay out of default context."
        ),
    )
    archive.add_argument("--hub", help="Override hub path for archive operations.")
    archive_sub = archive.add_subparsers(dest="archive_command", required=True)

    archive_list_parser = archive_sub.add_parser("list", help="List active and archived topics.")
    archive_list_parser.add_argument(
        "--archived",
        action="store_true",
        help="Show archived topics in addition to active topics.",
    )
    archive_list_parser.add_argument("--json", action="store_true", help="Print JSON.")

    archive_topic_parser = archive_sub.add_parser("topic", help="Archive an active topic wiki.")
    archive_topic_parser.add_argument("slug", help="Topic slug to archive.")
    archive_topic_parser.add_argument("--reason", help="Optional archive reason.")

    archive_restore_parser = archive_sub.add_parser("restore", help="Restore an archived topic wiki.")
    archive_restore_parser.add_argument("slug", help="Topic slug to restore.")

    archive.set_defaults(func=run_archive)

    schema = subparsers.add_parser(
        "schema",
        help="Manage the topic guide (`schema.md`).",
        description=(
            "Topic guides are default for topic wikis. Use status to inspect a wiki, "
            "or adopt to add an advisory starter topic guide (`schema.md`)."
        ),
    )
    schema.add_argument("--local", action="store_true", help="Target .wiki/ in the current directory.")
    schema.add_argument("--wiki", help="Named wiki from the hub registry.")
    schema.add_argument("--hub", help="Override hub path for --wiki resolution.")
    schema.add_argument(
        "--include-archived",
